{% extends 'base.html.twig' %}

{% block title %}My Order History - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/order_history.css') }}">
{% endblock %}

{% block body %}
    <div class="history-wrapper">
        <main class="history-container">
            <h2>My Order History</h2>

            {% for message in app.flashes('success') %}
                <div class="history-alert history-alert-success" role="status">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="history-alert history-alert-error" role="alert">{{ message }}</div>
            {% endfor %}

            {% if orders is empty %}
                <p style="color: #9ca3af;">You haven't placed any orders yet.</p>
                <a href="{{ path('shop_index') }}" class="btn-row-action btn-view" style="margin-top: 15px;">Browse Shop</a>
            {% else %}
                <div class="order-table-wrapper">
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Total Amount</th>
                                <th>Payment</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Date Placed</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                {% set status = order.customerOrder.status %}
                                {% set statusClass = status == 'Pending' or status == 'Cancellation Pending' ? 'badge-pending' : (status == 'Cancelled' ? 'badge-cancelled' : 'badge-completed') %}
                                {% set unitPrice = order.unitPrice ?? order.product.price %}
                                {% set recordType = order.customerOrder ? 'customer_order' : 'order_item' %}
                                {% set recordId = order.customerOrder ? order.customerOrder.id : order.id %}
                                <tr data-transaction-key="{{ recordType }}:{{ recordId }}">
                                    <td>#{{ order.customerOrder.id }}</td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            {% if order.product.image %}
                                                <img src="{{ asset(order.product.image) }}" alt="" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px; border: 1px solid #374151;">
                                            {% endif %}
                                            <span>{{ order.product.name }}</span>
                                        </div>
                                    </td>
                                    <td>{{ order.quantity }}</td>
                                    <td>₱{{ unitPrice|number_format(2) }}</td>
                                    <td>₱{{ order.totalAmount|number_format(2) }}</td>
                                    <td>{{ order.customerOrder.paymentMethod ?? 'N/A' }}</td>
                                    <td>{{ order.customerOrder.paymentReference ?? 'N/A' }}</td>
                                    <td><span class="badge {{ statusClass }}" data-transaction-status>{{ status }}</span></td>
                                    <td>{{ order.customerOrder.createdAt|date('M j, Y') }}</td>
                                    <td>
                                        <div class="table-actions">
                                            <button
                                                type="button"
                                                class="btn-row-action btn-view js-view-order"
                                                data-order-id="{{ order.customerOrder.id }}"
                                                data-product="{{ order.product.name }}"
                                                data-quantity="{{ order.quantity }}"
                                                data-unit-price="{{ unitPrice }}"
                                                data-total="{{ order.totalAmount }}"
                                                data-status="{{ status }}"
                                                data-created-at="{{ order.customerOrder.createdAt|date('Y-m-d H:i:s') }}"
                                                data-full-name="{{ order.user.firstName }} {{ order.user.lastName }}"
                                                data-phone="{{ order.user.phone ?? '' }}"
                                                data-address="{{ order.customerOrder.deliveryAddress ?? '' }}"
                                                data-payment-method="{{ order.customerOrder.paymentMethod ?? '' }}"
                                                data-payment-reference="{{ order.customerOrder.paymentReference ?? '' }}"
                                            >
                                                <i class="fa-solid fa-eye"></i> View
                                            </button>
                                            {% if status in ['Pending', 'Cancellation Pending'] %}
                                                <form method="post" action="{{ path('order_cancel', {id: order.id}) }}" data-cancel-form data-turbo="false" {% if status == 'Cancellation Pending' %}hidden{% endif %}>
                                                    <input type="hidden" name="_token" value="{{ csrf_token('order_cancel_' ~ order.id) }}">
                                                    <button type="submit" class="btn-row-action btn-cancel">
                                                        <i class="fa-solid fa-trash"></i> Cancel
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <a href="{{ path('shop_index') }}" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Back to Shop
            </a>
        </main>
    </div>

    <div class="modal-overlay" id="view-order-modal" aria-hidden="true">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="view-order-title">
            <header class="modal-header">
                <h3 id="view-order-title">Order Details <span id="view-order-id"></span></h3>
                <button type="button" class="modal-close js-close-view-order" aria-label="Close">&times;</button>
            </header>
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem; color: #f0f6fc;">
                <div><strong>Product:</strong> <span id="view-order-product"></span></div>
                <div><strong>Quantity:</strong> <span id="view-order-quantity"></span></div>
                <div><strong>Price (Unit):</strong> <span id="view-order-unit-price"></span></div>
                <div><strong>Total Amount:</strong> <span id="view-order-total"></span></div>
                <div><strong>Status:</strong> <span id="view-order-status"></span></div>
                <div><strong>Date Placed:</strong> <span id="view-order-date"></span></div>
                <div><strong>Full Name:</strong> <span id="view-order-name"></span></div>
                <div><strong>Phone Number:</strong> <span id="view-order-phone"></span></div>
                <div><strong>Delivery Address:</strong> <span id="view-order-address"></span></div>
                <div><strong>Payment Method:</strong> <span id="view-order-payment"></span></div>
                <div><strong>Payment Reference:</strong> <span id="view-order-reference"></span></div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-modal-secondary js-close-view-order">Close</button>
            </div>
        </section>
    </div>

    {% include 'shared/_cancellation_controls.html.twig' %}

    <script>
        (() => {
        const viewOrderModal = document.getElementById('view-order-modal');

        function setOrderModalOpen(modal, isOpen) {
            modal.classList.toggle('active', isOpen);
            modal.setAttribute('aria-hidden', String(!isOpen));
        }

        document.querySelectorAll('.js-view-order').forEach((button) => {
            button.addEventListener('click', () => {
                const values = button.dataset;
                document.getElementById('view-order-id').textContent = '#' + values.orderId;
                document.getElementById('view-order-product').textContent = values.product;
                document.getElementById('view-order-quantity').textContent = values.quantity;
                document.getElementById('view-order-unit-price').textContent = '₱' + Number(values.unitPrice).toFixed(2);
                document.getElementById('view-order-total').textContent = '₱' + Number(values.total).toFixed(2);
                document.getElementById('view-order-status').textContent = values.status;
                document.getElementById('view-order-date').textContent = values.createdAt;
                document.getElementById('view-order-name').textContent = values.fullName;
                document.getElementById('view-order-phone').textContent = values.phone;
                document.getElementById('view-order-address').textContent = values.address;
                document.getElementById('view-order-payment').textContent = values.paymentMethod || 'Cash on Delivery';
                document.getElementById('view-order-reference').textContent = values.paymentReference || 'N/A';
                setOrderModalOpen(viewOrderModal, true);
            });
        });

        document.querySelectorAll('.js-close-view-order').forEach((button) => {
            button.addEventListener('click', () => setOrderModalOpen(viewOrderModal, false));
        });
        viewOrderModal.addEventListener('click', (event) => {
            if (event.target === viewOrderModal) {
                setOrderModalOpen(viewOrderModal, false);
            }
        });
        })();
    </script>
{% endblock %}
