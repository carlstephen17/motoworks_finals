<aside class="admin-sidebar">
    <div class="sidebar-brand">
        <a href="{{ path('admin_dashboard') }}"><h2>MotoWorks Admin</h2></a>
    </div>
    <nav aria-label="Admin navigation">
        <ul class="sidebar-menu">
            {% set adminNavigation = [
                {route: 'admin_dashboard', label: 'Dashboard', path: path('admin_dashboard'), icon: 'fa-house'},
                {route: 'admin_products', label: 'Products', path: path('admin_products'), icon: 'fa-box'},
                {route: 'admin_orders', label: 'Orders', path: path('admin_orders'), icon: 'fa-cart-shopping'},
                {route: 'admin_services', label: 'Services', path: path('admin_services'), icon: 'fa-concierge-bell'},
                {route: 'admin_appointments', label: 'Appointments', path: path('admin_appointments'), icon: 'fa-calendar-check'},
                {route: 'admin_promos', label: 'Promo', path: path('admin_promos'), icon: 'fa-tags'},
                {route: 'admin_promo_history', label: 'Promo History', path: path('admin_promo_history'), icon: 'fa-tags'},
                {route: 'admin_users', label: 'Users', path: path('admin_users'), icon: 'fa-users'},
                {route: 'app_home', label: 'Website', path: path('app_home'), icon: 'fa-globe'}
            ] %}
            {% for item in adminNavigation %}
                {% set activeRoute = app.request.attributes.get('_route') %}
                {% if item.route == 'admin_promos' %}
                    {% set active = activeRoute == item.route or activeRoute starts with 'admin_promo_' and not (activeRoute starts with 'admin_promo_history') %}
                {% else %}
                    {% set active = activeRoute == item.route or activeRoute starts with item.route ~ '_' %}
                {% endif %}
                <li class="{{ active ? 'active' : '' }}">
                    <a href="{{ item.path }}" {{ active ? 'aria-current="page"' : '' }}><i class="fas {{ item.icon }}" aria-hidden="true"></i> {{ item.label }}</a>
                </li>
            {% endfor %}
            <li class="sidebar-logout">
                <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Logout</button>
                </form>
            </li>
        </ul>
    </nav>
</aside>
