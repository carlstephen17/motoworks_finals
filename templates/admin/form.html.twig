{% extends 'base.html.twig' %}

{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}{{ title }} | Bencalo MotoWorks{% endblock %}

{% block body %}
    <main>
        <h1>{{ title }}</h1>
        {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit">Save</button>
        {{ form_end(form) }}
    </main>
{% endblock %}
