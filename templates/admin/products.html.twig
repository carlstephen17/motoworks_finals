{% extends 'base.html.twig' %}
{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}Products | Admin{% endblock %}
{% block body %}
<main class="admin-main">
    {% include 'admin/_header.html.twig' with {
        title: 'Products Management',
        action: {id: 'productCreate', url: path('admin_product_new'), label: 'Add Product'}
    } %}
    <div class="admin-content-body">
    {% for message in app.flashes('success') %}<p role="status" data-auto-dismiss>{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert" data-auto-dismiss>{{ message }}</p>{% endfor %}
    <div class="table-filters">
        <label for="productSearch">Search products</label>
        <input id="productSearch" type="search" placeholder="Search products by name..." autocomplete="off">
        <label for="productStatus">Status</label>
        <select id="productStatus">
            <option value="">All statuses</option>
            <option value="1">Active</option>
            <option value="0">Inactive</option>
        </select>
    </div>
    <div class="table-responsive">
    <table class="admin-table" id="productTable">
        <thead><tr><th>ID</th><th>Image</th><th>Product name</th><th>Price</th><th>Status</th><th>Stock</th><th>Actions</th></tr></thead>
        <tbody>
        {% for product in products %}
            <tr data-name="{{ product.name|lower }}" data-status="{{ product.active ? '1' : '0' }}">
                <td>{{ product.id }}</td>
                <td>
                    {% if product.image %}
                        <img src="{{ asset(product.image) }}" alt="{{ product.name }}" width="40" height="40" style="object-fit: cover; border-radius: 4px;">
                    {% else %}
                        <span>No image</span>
                    {% endif %}
                </td>
                <td>{{ product.name }}</td>
                <td>₱{{ product.price|number_format(2) }}</td>
                <td><span class="badge {{ product.active ? 'badge-success' : 'badge-danger' }}">{{ product.active ? 'Active' : 'Inactive' }}</span></td>
                <td>{{ product.stock }}</td>
                <td class="table-row-actions">
                    <button type="button" class="btn-sm btn-secondary product-view" data-id="{{ product.id }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-stock="{{ product.stock }}" data-status="{{ product.active ? 'Active' : 'Inactive' }}" data-image="{{ product.image ? asset(product.image) : '' }}"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                    <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn-sm btn-info product-edit" data-action="{{ path('admin_product_edit', {id: product.id}) }}" data-id="{{ product.id }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-stock="{{ product.stock }}" data-active="{{ product.active ? '1' : '0' }}"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
                    <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" data-deferred-action="delete" data-confirm-message="Delete or deactivate this product? The change will be applied after the 3-second Undo window.">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_product_delete_' ~ product.id) }}">
                        <button type="submit" class="btn-sm btn-danger"><i class="fas fa-trash" aria-hidden="true"></i> Delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">No products found.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <dialog id="productDetails" class="modal-content" aria-labelledby="productDetailsTitle">
        <div class="modal-header"><h3 id="productDetailsTitle">Product details</h3></div>
        <img data-product-image alt="" width="100" height="100" style="object-fit: cover;">
        <p><strong>ID:</strong> <span data-product-id></span></p>
        <p><strong>Name:</strong> <span data-product-name></span></p>
        <p><strong>Price:</strong> <span data-product-price></span></p>
        <p><strong>Status:</strong> <span data-product-status></span></p>
        <p><strong>Stock:</strong> <span data-product-stock></span></p>
        <div class="modal-footer"><button type="button" class="btn-secondary" data-close-product-details>Close</button></div>
    </dialog>
    <dialog id="productFormDialog" class="modal-content product-form-dialog" aria-labelledby="productFormTitle" aria-describedby="productFormDescription">
        <div class="modal-header">
            <div>
                <span class="product-form-eyebrow">PRODUCT CATALOG</span>
                <h3 id="productFormTitle">Create product</h3>
            </div>
            <button type="button" class="close-btn" data-close-product-form aria-label="Close product form">×</button>
        </div>
        <p id="productFormDescription" class="product-form-intro">Add product details to make this item available in your catalog.</p>
        {{ form_start(productForm, {action: path('admin_product_new'), attr: {id: 'productAdminForm', class: 'product-admin-form'}}) }}
            <div class="product-form-grid">
                <div class="product-form-field product-form-field-full">
                    {{ form_label(productForm.name, 'Product name') }}
                    {{ form_widget(productForm.name, {attr: {class: 'form-control', placeholder: 'e.g. Premium Coffee Beans'}}) }}
                    {{ form_errors(productForm.name) }}
                </div>
                <div class="product-form-field">
                    {{ form_label(productForm.price, 'Price') }}
                    {{ form_widget(productForm.price, {attr: {class: 'form-control', placeholder: '0.00', inputmode: 'decimal'}}) }}
                    {{ form_errors(productForm.price) }}
                </div>
                <div class="product-form-field">
                    {{ form_label(productForm.stock, 'Stock quantity') }}
                    {{ form_widget(productForm.stock, {attr: {class: 'form-control', min: 0, placeholder: '0'}}) }}
                    {{ form_errors(productForm.stock) }}
                </div>
                <div class="product-form-field product-form-field-full">
                    {{ form_label(productForm.imageFile, 'Product image') }}
                    {{ form_widget(productForm.imageFile, {attr: {class: 'form-control product-form-file'}}) }}
                    <small class="product-form-help">Optional. JPG, PNG, or WebP up to 5 MB.</small>
                    {{ form_errors(productForm.imageFile) }}
                </div>
                <div class="product-form-toggle product-form-field-full">
                    {{ form_widget(productForm.active, {attr: {class: 'product-form-checkbox'}}) }}
                    <div>
                        {{ form_label(productForm.active, 'Available for sale') }}
                        <small class="product-form-help">Customers can see and purchase active products.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-close-product-form>Cancel</button>
                <button type="submit" class="btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> Save product</button>
            </div>
        {{ form_end(productForm) }}
    </dialog>
</div>
</main>
<script>
(() => {
    const table = document.getElementById('productTable');
    const search = document.getElementById('productSearch');
    const status = document.getElementById('productStatus');
    const dialog = document.getElementById('productDetails');
    const formDialog = document.getElementById('productFormDialog');
    const form = document.getElementById('productAdminForm');
    const createLink = document.getElementById('productCreate');
    if (!table || !search || !status || !dialog || !formDialog || !form || !createLink || table.dataset.bound) return;
    table.dataset.bound = 'true';
    const rows = [...table.querySelectorAll('tbody tr[data-name]')];
    const filterRows = () => {
        const term = search.value.trim().toLowerCase();
        rows.forEach(row => {
            row.hidden = !row.dataset.name.includes(term) || (status.value !== '' && row.dataset.status !== status.value);
        });
    };
    search.addEventListener('input', filterRows);
    status.addEventListener('change', filterRows);
    table.addEventListener('click', event => {
        const button = event.target.closest('.product-view');
        if (!button) return;
        dialog.querySelector('[data-product-id]').textContent = button.dataset.id;
        dialog.querySelector('[data-product-name]').textContent = button.dataset.name;
        dialog.querySelector('[data-product-price]').textContent = `₱${Number(button.dataset.price).toFixed(2)}`;
        dialog.querySelector('[data-product-status]').textContent = button.dataset.status;
        dialog.querySelector('[data-product-stock]').textContent = button.dataset.stock;
        const image = dialog.querySelector('[data-product-image]');
        image.hidden = !button.dataset.image;
        if (button.dataset.image) image.src = button.dataset.image;
        else image.removeAttribute('src');
        dialog.showModal();
    });
    dialog.querySelector('[data-close-product-details]').addEventListener('click', () => dialog.close());
    const title = document.getElementById('productFormTitle');
    createLink.addEventListener('click', event => {
        event.preventDefault();
        form.reset();
        form.action = createLink.dataset.createUrl;
        title.textContent = 'Create product';
        document.getElementById('productFormDescription').textContent = 'Add product details to make this item available in your catalog.';
        formDialog.showModal();
    });
    table.addEventListener('click', event => {
        const link = event.target.closest('.product-edit');
        if (!link) return;
        event.preventDefault();
        form.reset();
        form.action = link.dataset.action;
        form.elements.namedItem('product[name]').value = link.dataset.name;
        form.elements.namedItem('product[price]').value = link.dataset.price;
        form.elements.namedItem('product[stock]').value = link.dataset.stock;
        form.elements.namedItem('product[active]').checked = link.dataset.active === '1';
        title.textContent = 'Edit product';
        document.getElementById('productFormDescription').textContent = 'Update product details. Leave the image empty to keep the current image.';
        formDialog.showModal();
    });
    formDialog.querySelectorAll('[data-close-product-form]').forEach(button => {
        button.addEventListener('click', () => formDialog.close());
    });
})();
</script>
{% endblock %}
