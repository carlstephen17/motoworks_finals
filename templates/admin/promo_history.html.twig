{% extends 'base.html.twig' %}
{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}Promotion History | Admin{% endblock %}
{% block body %}
<main class="admin-main">
    {% include 'admin/_header.html.twig' with {title: 'Promotion History', headerInfo: 'Customer claims and redemptions'} %}
    <div class="admin-content-body">
        {% for message in app.flashes('success') %}<p role="status" data-auto-dismiss>{{ message }}</p>{% endfor %}
        {% for message in app.flashes('error') %}<p role="alert" data-auto-dismiss>{{ message }}</p>{% endfor %}
        <div class="promo-history-toolbar">
            <a class="btn-secondary" href="{{ path('admin_promos') }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Promotions</a>
            <button type="button" class="btn-primary" id="addPromoClaim" data-form-url="{{ path('admin_promo_history_new') }}"><i class="fas fa-plus" aria-hidden="true"></i> Create Claim</button>
        </div>
        {% include 'admin/_promo_history_content.html.twig' with {
            claims: claims,
            claimUpdateForm: claimUpdateForm
        } %}
        <dialog id="promoClaimCreateDialog" class="admin-edit-dialog" aria-labelledby="promoClaimCreateTitle">
            <div id="promoClaimCreateContent"></div>
        </dialog>
    </div>
</main>
<script>
(() => {
    const openButton = document.getElementById('addPromoClaim');
    const dialog = document.getElementById('promoClaimCreateDialog');
    const content = document.getElementById('promoClaimCreateContent');
    if (!openButton || !dialog || !content) return;

    const notify = (message, type) => {
        if (typeof window.showAdminToast === 'function') window.showAdminToast(message, type);
        else console.error(message);
    };

    openButton.addEventListener('click', async () => {
        try {
            const response = await fetch(openButton.dataset.formUrl, {
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                credentials: 'same-origin'
            });
            if (!response.ok) throw new Error(`Claim form could not be loaded (${response.status}).`);
            content.innerHTML = await response.text();
            const optionData = content.querySelector('[data-promo-options]');
            const form = content.querySelector('#promoClaimCreateForm');
            const promoSelect = form?.querySelector('[data-promo-select]');
            const optionSelect = form?.querySelector('[data-promo-option]');
            if (optionData && promoSelect && optionSelect) {
                const optionsByPromo = JSON.parse(optionData.dataset.promoOptions);
                const updateOptions = () => {
                    const selectedOptions = optionsByPromo[promoSelect.value] || [];
                    optionSelect.replaceChildren(new Option('Choose promotion option', ''));
                    selectedOptions.forEach((option) => optionSelect.add(new Option(option, option)));
                };
                promoSelect.addEventListener('change', updateOptions);
                updateOptions();
            }
            dialog.showModal();
        } catch (error) {
            console.error('Unable to load the promotion claim form.', error);
            notify(error.message || 'Unable to load the promotion claim form.', 'error');
        }
    });

    dialog.addEventListener('click', (event) => {
        if (event.target.closest('[data-close-promo-claim-create]')) dialog.close();
    });
    dialog.addEventListener('submit', async (event) => {
        const form = event.target.closest('#promoClaimCreateForm');
        if (!form) return;
        event.preventDefault();
        if (form.dataset.submitting === 'true') return;
        form.dataset.submitting = 'true';
        const submitButton = event.submitter;
        if (submitButton) submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                credentials: 'same-origin'
            });
            const result = await response.json();
            if (!response.ok || result.success !== true) throw new Error(result.message || `Claim creation failed (${response.status}).`);
            dialog.close();
            notify(result.message || 'Promotion claim created.', 'success');
            window.setTimeout(() => window.location.reload(), 700);
        } catch (error) {
            console.error('Unable to create the promotion claim.', error);
            notify(error.message || 'Unable to create the promotion claim.', 'error');
        } finally {
            form.dataset.submitting = 'false';
            if (submitButton) submitButton.disabled = false;
        }
    });
})();
</script>
{% endblock %}
