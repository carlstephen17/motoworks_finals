{% extends 'base.html.twig' %}
{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}Promotion history | Admin{% endblock %}
{% block body %}
<main>
    <h1>Promotion claim history</h1>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
    {% for claim in claims %}
        <article>
            <h2>{{ claim.bundleSlug }} — {{ claim.selectedOption }}</h2>
            <p>{{ claim.fullName }} · {{ claim.phone }} · {{ claim.appointmentDate|date('M j, Y') }} · {{ claim.status }}</p>
            <a href="{{ path('admin_promo_history_edit', {id: claim.id}) }}">Edit claim details</a>
            <form method="post" action="{{ path('admin_promo_history_status', {id: claim.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_promo_history_status_' ~ claim.id) }}">
                <select name="status">{% for status in ['Pending','Confirmed','Used','Completed','Cancelled'] %}<option {{ claim.status == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select>
                <button type="submit">Update</button>
            </form>
            <form method="post" action="{{ path('admin_promo_history_delete', {id: claim.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_promo_history_delete_' ~ claim.id) }}"><button type="submit">Delete claim</button></form>
        </article>
    {% else %}<p>No promotion claims.</p>{% endfor %}
</main>
{% endblock %}
