{% extends 'base.html.twig' %}
{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}Promotions | Admin{% endblock %}
{% block body %}
<main>
    <h1>Promotions</h1>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
    <p><a href="{{ path('admin_promo_new') }}">Create promotion</a></p>
    {% for promo in promos %}
        <article><h2>{{ promo.title }} — {{ promo.badge }}</h2><p>{{ promo.description }}</p><p>{{ promo.active ? 'Active' : 'Inactive' }}</p>
            <a href="{{ path('admin_promo_edit', {id: promo.id}) }}">Edit</a>
            <form method="post" action="{{ path('admin_promo_status', {id: promo.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_promo_status_' ~ promo.id) }}"><input type="hidden" name="active" value="{{ promo.active ? '0' : '1' }}"><button>{{ promo.active ? 'Deactivate' : 'Activate' }}</button></form>
            <form method="post" action="{{ path('admin_promo_delete', {id: promo.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_promo_delete_' ~ promo.id) }}"><button type="submit">Deactivate</button></form>
        </article>
    {% else %}<p>No promotions.</p>{% endfor %}
</main>
{% endblock %}
