{% extends 'base.html.twig' %}
{% block site_header %}{% include 'admin/_sidebar.html.twig' %}{% endblock %}
{% block title %}Users | Admin{% endblock %}
{% block body %}
<main class="admin-main">
    {% include 'admin/_header.html.twig' with {title: 'Users & Customers Management', headerInfo: 'Account Directory'} %}
    <div class="admin-content-body">
    {% for message in app.flashes('success') %}<p role="status" data-auto-dismiss>{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert" data-auto-dismiss>{{ message }}</p>{% endfor %}
    <details class="admin-user-create">
        <summary>Create User or Staff Account</summary>
        {{ form_start(createUserForm, {action: path('admin_user_new'), attr: {class: 'admin-user-create-grid'}}) }}
            {{ form_widget(createUserForm) }}
            <button type="submit" class="btn-primary">Create Account</button>
        {{ form_end(createUserForm) }}
    </details>

    <section class="table-filters" aria-label="Filter users">
        <label for="userSearch">Search username, name, email, or phone</label>
        <input id="userSearch" type="search">
        <label for="userRole">Role</label>
        <select id="userRole">
            <option value="">All roles</option>
            <option value="admin">Admin</option>
            <option value="staff">Staff</option>
            <option value="customer">Customer</option>
        </select>
    </section>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr><th>ID</th><th>Username</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined date</th><th>Actions</th></tr>
            </thead>
            <tbody id="userRows">
            {% for user in users %}
                {% set userDetails = {
                    id: user.id,
                    firstName: user.firstName,
                    lastName: user.lastName,
                    username: user.username,
                    email: user.email,
                    phone: user.phone,
                    role: user.role,
                    createdAt: user.createdAt|date('Y-m-d H:i')
                } %}
                <tr class="user-row" data-id="{{ user.id }}" data-role="{{ user.role }}" data-search="{{ [user.username, user.firstName, user.lastName, user.email, user.phone]|join(' ')|lower|e('html_attr') }}">
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.firstName }} {{ user.lastName }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.phone|default('N/A') }}</td>
                    <td><span class="role-badge role-{{ user.role }}">{{ user.role|capitalize }}</span></td>
                    <td>{{ user.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="table-row-actions">
                        <button type="button" class="btn-sm btn-secondary view-user" data-user="{{ userDetails|json_encode|e('html_attr') }}"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                        <a class="btn-sm btn-info user-edit" href="{{ path('admin_user_edit', {id: user.id}) }}" data-action="{{ path('admin_user_edit', {id: user.id}) }}" data-user="{{ userDetails|json_encode|e('html_attr') }}"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
                        <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" data-deferred-action="delete" data-confirm-message="Delete this user? The change will be applied after the 3-second Undo window.">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                            <button type="submit" class="btn-sm btn-danger"><i class="fas fa-trash" aria-hidden="true"></i> Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8">No users found.</td></tr>
            {% endfor %}
                <tr id="noFilteredUsers" hidden><td colspan="8">No users match these filters.</td></tr>
            </tbody>
        </table>
    </div>

    <dialog id="userDetails" class="modal-content">
        <div class="modal-header"><h3>User Profile Details</h3></div>
        <dl>
            <dt>User ID</dt><dd data-detail="id"></dd>
            <dt>First name</dt><dd data-detail="firstName"></dd>
            <dt>Last name</dt><dd data-detail="lastName"></dd>
            <dt>Username</dt><dd data-detail="username"></dd>
            <dt>Email</dt><dd data-detail="email"></dd>
            <dt>Phone</dt><dd data-detail="phone"></dd>
            <dt>Role</dt><dd data-detail="role"></dd>
            <dt>Joined date</dt><dd data-detail="createdAt"></dd>
        </dl>
        <div class="modal-footer"><button type="button" id="closeUserDetails" class="btn-secondary">Close</button></div>
    </dialog>
    <dialog id="userEditDialog" class="modal-content admin-edit-dialog" aria-labelledby="userEditTitle">
        <div class="modal-header">
            <div>
                <p class="admin-edit-eyebrow">Account directory</p>
                <h3 id="userEditTitle">Edit User Account</h3>
            </div>
            <button type="button" class="close-btn" data-close-user-edit aria-label="Close">×</button>
        </div>
        <p class="admin-edit-intro">Update this account's profile and access role. Leave the password blank to keep it unchanged.</p>
        {{ form_start(editUserForm, {action: path('admin_user_edit', {id: 0}), attr: {id: 'userEditForm', class: 'admin-edit-form'}}) }}
            <section class="admin-edit-section">
                <h4 class="admin-edit-section-title">Profile</h4>
                <div class="admin-edit-form-grid">
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.firstName) }}
                        {{ form_widget(editUserForm.firstName, {attr: {class: 'form-control', autocomplete: 'given-name'}}) }}
                        {{ form_errors(editUserForm.firstName) }}
                    </div>
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.lastName) }}
                        {{ form_widget(editUserForm.lastName, {attr: {class: 'form-control', autocomplete: 'family-name'}}) }}
                        {{ form_errors(editUserForm.lastName) }}
                    </div>
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.username) }}
                        {{ form_widget(editUserForm.username, {attr: {class: 'form-control', autocomplete: 'username'}}) }}
                        {{ form_errors(editUserForm.username) }}
                    </div>
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.email) }}
                        {{ form_widget(editUserForm.email, {attr: {class: 'form-control', autocomplete: 'email'}}) }}
                        {{ form_errors(editUserForm.email) }}
                    </div>
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.phone) }}
                        {{ form_widget(editUserForm.phone, {attr: {class: 'form-control', autocomplete: 'tel'}}) }}
                        {{ form_errors(editUserForm.phone) }}
                    </div>
                    <div class="admin-edit-field">
                        {{ form_label(editUserForm.role) }}
                        {{ form_widget(editUserForm.role, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(editUserForm.role) }}
                    </div>
                </div>
            </section>
            <section class="admin-edit-section">
                <h4 class="admin-edit-section-title">Security</h4>
                <div class="admin-edit-form-grid">
                    <div class="admin-edit-field admin-edit-field-full">
                        {{ form_label(editUserForm.plainPassword, 'New password') }}
                        {{ form_widget(editUserForm.plainPassword, {attr: {class: 'form-control', autocomplete: 'new-password'}}) }}
                        {{ form_errors(editUserForm.plainPassword) }}
                    </div>
                </div>
            </section>
            {{ form_rest(editUserForm) }}
            <div class="modal-footer">
                <button type="button" class="btn-secondary" data-close-user-edit>Cancel</button>
                <button type="submit" class="btn-primary">Save changes</button>
            </div>
        {{ form_end(editUserForm) }}
    </dialog>
</div>
</main>
<script>
    const userSearch = document.getElementById('userSearch');
    const userRole = document.getElementById('userRole');
    const userRows = [...document.querySelectorAll('.user-row')];
    const noFilteredUsers = document.getElementById('noFilteredUsers');
    const userEditDialog = document.getElementById('userEditDialog');
    const userEditForm = document.getElementById('userEditForm');

    function filterUsers() {
        const query = userSearch.value.trim().toLowerCase();
        const role = userRole.value;
        let visibleCount = 0;

        userRows.forEach((row) => {
            const visible = row.dataset.search.includes(query) && (!role || row.dataset.role === role);
            row.hidden = !visible;
            visibleCount += Number(visible);
        });
        noFilteredUsers.hidden = visibleCount > 0;
    }

    userSearch.addEventListener('input', filterUsers);
    userRole.addEventListener('change', filterUsers);

    const userDetails = document.getElementById('userDetails');
    document.querySelectorAll('.view-user').forEach((button) => {
        button.addEventListener('click', () => {
            const details = JSON.parse(button.dataset.user);
            Object.entries(details).forEach(([key, value]) => {
                userDetails.querySelector(`[data-detail="${key}"]`).textContent = value || 'N/A';
            });
            userDetails.showModal();
        });
    });
    document.getElementById('closeUserDetails').addEventListener('click', () => userDetails.close());
    document.querySelectorAll('[data-close-user-edit]').forEach((button) => {
        button.addEventListener('click', () => userEditDialog.close());
    });
    document.getElementById('userRows').addEventListener('click', (event) => {
        const link = event.target.closest('.user-edit');
        if (!link) return;
        event.preventDefault();
        const user = JSON.parse(link.dataset.user);
        userEditForm.reset();
        userEditForm.action = link.dataset.action;
        ['firstName', 'lastName', 'username', 'email', 'phone', 'role'].forEach((field) => {
            userEditForm.elements.namedItem(`admin_user[${field}]`).value = user[field] ?? '';
        });
        userEditDialog.showModal();
    });

    const showUserNotification = (message, success) => {
        if (typeof window.showAdminToast === 'function') {
            window.showAdminToast(message, success ? 'success' : 'error');
        } else {
            console.error(message);
        }
    };

    userEditForm.addEventListener('submit', async (event) => {
        const editPath = new URL(userEditForm.action, window.location.href).pathname;
        if (!/^\/admin\/users\/\d+\/edit$/.test(editPath)) return;
        event.preventDefault();
        if (userEditForm.dataset.submitting === 'true') return;
        userEditForm.dataset.submitting = 'true';
        const submitButton = event.submitter;
        if (submitButton) submitButton.disabled = true;

        try {
            const response = await fetch(userEditForm.action, {
                method: 'POST',
                body: new FormData(userEditForm),
                headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                credentials: 'same-origin'
            });
            const contentType = response.headers.get('content-type') || '';
            const result = contentType.includes('application/json') ? await response.json() : {};
            if (!response.ok || result.success !== true) {
                throw new Error(result.message || `User update failed (${response.status}).`);
            }

            const user = result.user;
            const row = document.querySelector(`.user-row[data-id="${user.id}"]`);
            if (!row) throw new Error('The updated user row could not be found.');
            row.dataset.role = user.role;
            row.dataset.search = [user.username, user.firstName, user.lastName, user.email, user.phone].join(' ').toLowerCase();
            row.cells[1].textContent = user.username;
            row.cells[2].textContent = `${user.firstName} ${user.lastName}`;
            row.cells[3].textContent = user.email;
            row.cells[4].textContent = user.phone || 'N/A';
            row.cells[5].querySelector('.role-badge').className = `role-badge role-${user.role}`;
            row.cells[5].querySelector('.role-badge').textContent = user.role.charAt(0).toUpperCase() + user.role.slice(1);

            const details = {
                ...user,
                createdAt: user.createdAt
            };
            row.querySelector('.view-user').dataset.user = JSON.stringify(details);
            const editLink = row.querySelector('.user-edit');
            editLink.dataset.user = JSON.stringify(details);
            filterUsers();
            userEditDialog.close();
            showUserNotification(result.message || 'User updated.', true);
        } catch (error) {
            console.error('Unable to update user.', error);
            showUserNotification(error.message || 'Unable to update user.', false);
        } finally {
            userEditForm.dataset.submitting = 'false';
            if (submitButton) submitButton.disabled = false;
        }
    });
</script>
{% endblock %}
