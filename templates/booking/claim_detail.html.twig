{% extends 'base.html.twig' %}

{% block title %}Promotion claim | Bencalo MotoWorks{% endblock %}

{% block body %}
    <main class="container" style="padding-top: 40px; padding-bottom: 60px;">
        <h1>Promotion claim</h1>
        <p><strong>Bundle / Promo:</strong> {{ record.bundleSlug }}</p>
        <p><strong>Selected option:</strong> {{ record.selectedOption ?: 'N/A' }}</p>
        <p><strong>Full name:</strong> {{ record.fullName ?: 'N/A' }}</p>
        <p><strong>Phone number:</strong> {{ record.phone ?: 'N/A' }}</p>
        {% if record.vehicleModel %}
            <p><strong>Vehicle model:</strong> {{ record.vehicleModel }}</p>
        {% endif %}
        <p><strong>Appointment:</strong> {{ record.appointmentDate|date('M j, Y') }} at {{ record.appointmentTime|date('g:i A') }}</p>
        <p><strong>Status:</strong> {{ record.status }}</p>

        <a href="{{ path('promo_history') }}">Back to promotion history</a>
    </main>
{% endblock %}
