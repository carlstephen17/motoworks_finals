{% extends 'base.html.twig' %}

{% block title %}Promotion history | Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/promo_history.css') }}">
    <style>
        .claim-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 11000;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(0, 0, 0, 0.75);
        }
        .claim-modal.active { display: flex; }
        .claim-modal-card {
            width: 100%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 24px;
            border: 1px solid #30363d;
            border-radius: 8px;
            background: #161b22;
            color: #f0f6fc;
        }
        .claim-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }
        .claim-modal-header h2 { margin: 0; color: #00d2d3; font-size: 1.25rem; }
        .claim-modal-close { border: 0; background: none; color: #8b949e; font-size: 1.5rem; cursor: pointer; }
        .claim-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
        .claim-modal-actions button { padding: 8px 16px; border: 0; border-radius: 6px; cursor: pointer; }
        .claim-modal-secondary { background: #21262d; color: #f0f6fc; }
    </style>
{% endblock %}

{% block body %}
    <div class="history-wrapper">
        <main class="history-container">
            <a href="{{ path('promo_index') }}" class="back-link">Promotions</a>
            <h1 class="history-title">Promo Claim &amp; Appointment History</h1>

            {% for message in app.flashes('success') %}
                <div class="success-alert" role="status" data-auto-dismiss>{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="success-alert" role="alert" data-auto-dismiss style="border-color: #ff4757; color: #ff4757;">{{ message }}</div>
            {% endfor %}

            <div class="order-table-wrapper">
                <table class="styled-table">
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Promotion / Bundle</th>
                            <th>Selected Option</th>
                            <th>Transaction Date</th>
                            <th>Appointment</th>
                            <th>Phone</th>
                            <th>Transaction Status</th>
                            <th>Payment Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for claim in claims %}
                            {% set statusClass = claim.status|lower == 'completed' ? 'badge-completed' : (claim.status|lower starts with 'cancel' ? 'badge-cancelled' : 'badge-pending') %}
                            <tr data-transaction-key="{{ claim.type }}:{{ claim.id }}">
                                <td><strong>{{ claim.type == 'promo_claim' ? 'PC' : 'SB' }}-{{ claim.id }}</strong></td>
                                <td>
                                    <span class="bundle-name">{{ claim.promoTitle ?: claim.bundleSlug }}</span>
                                    {% if claim.promoId %}<span class="appointment-meta">Promo #{{ claim.promoId }}</span>{% endif %}
                                    {% if claim.serviceName %}<span class="appointment-meta">{{ claim.serviceName }}</span>{% endif %}
                                </td>
                                <td>{{ claim.selectedOption }}</td>
                                <td>{{ (claim.createdAt ?: claim.appointmentDate)|date('M j, Y g:i A') }}</td>
                                <td>
                                    {{ claim.appointmentDate|date('F j, Y') }}
                                    <span class="appointment-meta">{{ claim.appointmentTime|date('g:i A') }}</span>
                                </td>
                                <td>{{ claim.phone ?: 'N/A' }}</td>
                                <td><span class="badge {{ statusClass }}" data-transaction-status>{{ claim.status }}</span></td>
                                <td>Not applicable</td>
                                <td>
                                    <div class="table-actions">
                                        <button
                                            type="button"
                                            class="btn-view js-view-claim"
                                            data-bundle="{{ claim.promoTitle ?: claim.bundleSlug }}"
                                            data-promo-id="{{ claim.promoId ?? '' }}"
                                            data-reference="{{ claim.type == 'promo_claim' ? 'PC' : 'SB' }}-{{ claim.id }}"
                                            data-created="{{ (claim.createdAt ?: claim.appointmentDate)|date('M j, Y g:i A') }}"
                                            data-option="{{ claim.selectedOption }}"
                                            data-name="{{ claim.fullName }}"
                                            data-phone="{{ claim.phone ?? '' }}"
                                            data-date="{{ claim.appointmentDate|date('Y-m-d') }}"
                                            data-time="{{ claim.appointmentTime|date('H:i') }}"
                                            data-status="{{ claim.status }}"
                                            data-payment-status="Not applicable"
                                            data-service="{{ claim.serviceName ?? '' }}"
                                            data-vehicle="{{ claim.vehicleModel ?? '' }}"
                                        >
                                            <i class="fa-solid fa-eye"></i> View
                                        </button>
                                        {% if claim.status|lower in ['pending', 'cancellation pending'] %}
                                            <form method="post" action="{{ path('promo_claim_delete', {type: claim.type, id: claim.id}) }}" data-cancel-form data-turbo="false" {% if claim.status|lower == 'cancellation pending' %}hidden{% endif %}>
                                                <input type="hidden" name="_token" value="{{ csrf_token('promo_history_delete_' ~ claim.type ~ '_' ~ claim.id) }}">
                                                <button type="submit" class="btn-cancel"><i class="fa-solid fa-ban"></i> Cancel</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9" class="empty-state">No promo claims found.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <div class="claim-modal" id="view-claim-modal" aria-hidden="true">
        <section class="claim-modal-card" role="dialog" aria-modal="true" aria-labelledby="view-claim-title">
            <header class="claim-modal-header">
                <h2 id="view-claim-title">Promotion Claim Details</h2>
                <button type="button" class="claim-modal-close js-close-view-claim" aria-label="Close">&times;</button>
            </header>
            <div class="modal-details">
                <p><strong>Bundle / Promo:</strong> <span id="view-claim-bundle"></span></p>
                <p><strong>Transaction:</strong> <span id="view-claim-reference"></span></p>
                <p><strong>Promotion ID:</strong> <span id="view-claim-promo-id"></span></p>
                <p><strong>Selected Option:</strong> <span id="view-claim-option"></span></p>
                <p><strong>Service:</strong> <span id="view-claim-service"></span></p>
                <p><strong>Full Name:</strong> <span id="view-claim-name"></span></p>
                <p><strong>Contact Phone:</strong> <span id="view-claim-phone"></span></p>
                <p><strong>Vehicle Model:</strong> <span id="view-claim-vehicle"></span></p>
                <p><strong>Appointment Date:</strong> <span id="view-claim-date"></span></p>
                <p><strong>Time Slot:</strong> <span id="view-claim-time"></span></p>
                <p><strong>Current Status:</strong> <span id="view-claim-status"></span></p>
                <p><strong>Payment Status:</strong> <span id="view-claim-payment-status"></span></p>
                <p><strong>Transaction Date:</strong> <span id="view-claim-created"></span></p>
            </div>
            <div class="claim-modal-actions">
                <button type="button" class="claim-modal-secondary js-close-view-claim">Close</button>
            </div>
        </section>
    </div>

    {% include 'shared/_cancellation_controls.html.twig' %}

    <script>
        (() => {
        const viewClaimModal = document.getElementById('view-claim-modal');

        function setClaimModalOpen(modal, isOpen) {
            modal.classList.toggle('active', isOpen);
            modal.setAttribute('aria-hidden', String(!isOpen));
        }

        document.querySelectorAll('.js-view-claim').forEach((button) => {
            button.addEventListener('click', () => {
                const values = button.dataset;
                document.getElementById('view-claim-bundle').textContent = values.bundle || 'N/A';
                document.getElementById('view-claim-reference').textContent = values.reference || 'N/A';
                document.getElementById('view-claim-promo-id').textContent = values.promoId || 'N/A';
                document.getElementById('view-claim-option').textContent = values.option || 'N/A';
                document.getElementById('view-claim-service').textContent = values.service || 'N/A';
                document.getElementById('view-claim-name').textContent = values.name || 'N/A';
                document.getElementById('view-claim-phone').textContent = values.phone || 'N/A';
                document.getElementById('view-claim-vehicle').textContent = values.vehicle || 'N/A';
                document.getElementById('view-claim-date').textContent = values.date || 'N/A';
                document.getElementById('view-claim-time').textContent = values.time || 'N/A';
                document.getElementById('view-claim-status').textContent = values.status || 'Pending';
                document.getElementById('view-claim-payment-status').textContent = values.paymentStatus || 'Not applicable';
                document.getElementById('view-claim-created').textContent = values.created || 'N/A';
                setClaimModalOpen(viewClaimModal, true);
            });
        });

        document.querySelectorAll('.js-close-view-claim').forEach((button) => {
            button.addEventListener('click', () => setClaimModalOpen(viewClaimModal, false));
        });
        viewClaimModal.addEventListener('click', (event) => {
            if (event.target === viewClaimModal) {
                setClaimModalOpen(viewClaimModal, false);
            }
        });
        })();
    </script>
{% endblock %}
