{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} | Bencalo MotoWorks{% endblock %}

{% block body %}
    <main>
        <h1>{{ page.title }}</h1>
        <p>{{ page.intro }}</p>
        {% for section in page.sections %}
            <section>
                <h2>{{ section.title }}</h2>
                <p>{{ section.body }}</p>
            </section>
        {% endfor %}
    </main>
{% endblock %}
