<main class="admin-main">
    {% if app.request.pathinfo starts with '/staff' %}
        {% include 'staff/_header.html.twig' with {title: heading} %}
    {% else %}
        {% include 'admin/_header.html.twig' with {title: heading, headerInfo: headerInfo|default('Welcome back, Admin')} %}
    {% endif %}
    <div class="admin-content-body">
    {% for message in app.flashes('success') %}<p role="status" data-auto-dismiss>{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert" data-auto-dismiss>{{ message }}</p>{% endfor %}
    {% set isAdminOrdersPage = app.request.pathinfo starts with '/admin' %}
    <section class="order-stats" aria-label="Order totals">
        {% for key, label in { total: 'All Orders', pending: 'Pending', cancelled: 'Cancelled', completed: 'Completed' } %}
            <article class="stat-card" data-order-count="{{ key }}"><div class="stat-info"><h3>{{ counts[key] }}</h3><p>{{ label }}</p></div></article>
        {% endfor %}
    </section>

    <form class="order-filters" method="get" action="{{ path(app.request.attributes.get('_route')) }}">
        <div class="form-group">
        <label for="orderSearch">Search order, customer, or product</label>
        <input class="form-control" id="orderSearch" name="search" value="{{ filters.search }}" placeholder="Order ID, name, email, phone, product">
        </div><div class="form-group">
        <label for="orderStatus">Order status</label>
        <select class="form-control" id="orderStatus" name="status" data-auto-submit>
            <option value="">All statuses</option>
            {% for option in ['Pending', 'Completed', 'Cancelled'] %}
                <option value="{{ option }}" {{ filters.status == option ? 'selected' : '' }}>{{ option }}</option>
            {% endfor %}
        </select></div><div class="form-group">
        <label for="paymentStatus">Payment status</label>
        <select class="form-control" id="paymentStatus" name="payment_status" data-auto-submit>
            <option value="">All payment states</option>
            {% for option in ['Due on delivery', 'Pending', 'Paid'] %}
                <option value="{{ option }}" {{ filters.paymentStatus == option ? 'selected' : '' }}>{{ option }}</option>
            {% endfor %}
        </select></div><div class="form-group">
        <label for="dateFrom">From</label>
        <input class="form-control" id="dateFrom" type="date" name="date_from" value="{{ filters.dateFrom }}" data-auto-submit>
        </div><div class="form-group">
        <label for="dateTo">To</label>
        <input class="form-control" id="dateTo" type="date" name="date_to" value="{{ filters.dateTo }}" data-auto-submit>
        </div>
        {% if createRoute %}
            {% if isAdminOrdersPage %}
                <button type="button" class="btn-primary order-create-button" data-order-create-url="{{ path(createRoute) }}"><i class="fas fa-plus" aria-hidden="true"></i> Create order</button>
            {% else %}
                <a class="btn-primary order-create-button" href="{{ path(createRoute) }}"><i class="fas fa-plus" aria-hidden="true"></i> Create order</a>
            {% endif %}
        {% endif %}
    </form>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr><th>Order</th><th>Customer</th><th>Products</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th>Actions</th></tr>
            </thead>
            <tbody>
            {% for order in orders %}
                {% set groupId = order.orderGroupId %}
                {% set items = itemsByOrder[groupId]|default([]) %}
                <tr>
                    <td><strong>#{{ groupId }}</strong><br><small>{{ order.itemCount }} item(s)</small></td>
                    <td>{{ order.firstName }} {{ order.lastName }}<br><small>{{ order.email }}<br>{{ order.phone }}</small></td>
                    <td class="order-items">
                        {% for item in items %}
                            <div class="order-item">
                                {% if item.productImage %}<img src="{{ asset(item.productImage) }}" alt="" width="36" height="36">{% endif %}
                                <span>{{ item.productName }} × {{ item.quantity }}</span>
                                <strong>₱{{ item.totalAmount|number_format(2) }}</strong>
                            </div>
                        {% else %}
                            <span>No order items recorded</span>
                        {% endfor %}
                    </td>
                    <td>₱{{ order.orderTotal|number_format(2) }}</td>
                    <td>{{ order.paymentMethod|default('Not recorded') }}<br><span class="badge badge-secondary">{{ order.paymentStatus }}</span></td>
                    <td><span class="badge {{ order.displayStatus == 'Completed' ? 'badge-success' : (order.displayStatus == 'Cancelled' ? 'badge-danger' : 'badge-warning') }}" data-order-status-label>{{ order.displayStatus }}</span></td>
                    <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="table-row-actions">
                        <button type="button" class="btn-sm btn-secondary" data-open-order-details="order-view-details-{{ groupId }}"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                        {% set canModifyOrder = is_granted('ROLE_ADMIN') or not order.createdByStaffId or order.createdByStaffId == app.user.id %}
                        {% if canModifyOrder and order.currentStatus not in ['Completed', 'Cancellation Pending'] %}
                            <button type="button" class="btn-sm btn-info" data-edit-order-details="order-edit-details-{{ groupId }}"><i class="fas fa-edit" aria-hidden="true"></i> Edit</button>
                        {% endif %}
                        {% if canModifyOrder and deleteRoute is defined and deleteRoute %}
                            <form method="post" action="{{ path(deleteRoute, {id: groupId}) }}" data-deferred-action="delete" data-confirm-message="Permanently delete order #{{ groupId }}? Pending-order stock will be restored.">
                                <input type="hidden" name="_token" value="{{ csrf_token(deleteRoute ~ '_' ~ groupId) }}">
                                <button type="submit" class="btn-sm btn-danger"><i class="fas fa-trash" aria-hidden="true"></i> Delete</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
                <tr class="order-details-row"><td colspan="8">
                <dialog class="order-details-modal {{ not isAdminOrdersPage ? 'staff-order-dialog' : '' }}" id="order-view-details-{{ groupId }}" aria-labelledby="order-view-details-title-{{ groupId }}">
                    <div class="order-details-modal-header">
                        <h3 id="order-view-details-title-{{ groupId }}">Order #{{ groupId }} Details</h3>
                        <button class="btn-sm btn-danger" type="button" data-close-order-details aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </div>
                    <div class="order-details-body">
                        <section class="order-detail-section">
                            <h4>Order and customer</h4>
                            <dl class="order-detail-grid">
                                <div><dt>Order ID</dt><dd>#{{ groupId }}</dd></div>
                                <div><dt>Placed</dt><dd>{{ order.createdAt|date('M j, Y · g:i A') }}</dd></div>
                                <div><dt>Customer</dt><dd>{{ order.firstName }} {{ order.lastName }}</dd></div>
                                <div><dt>Email / phone</dt><dd>{{ order.email }} · {{ order.phone|default('Not recorded') }}</dd></div>
                                <div class="order-detail-full"><dt>Delivery address</dt><dd>{{ order.deliveryAddress|default('Not recorded') }}</dd></div>
                            </dl>
                        </section>
                        <section class="order-detail-section">
                            <h4>Items</h4>
                            <ul class="order-item-details">
                            {% for item in items %}
                                <li>{{ item.productName }} — {{ item.quantity }} × ₱{{ item.unitPrice|number_format(2) }} = ₱{{ item.totalAmount|number_format(2) }}</li>
                            {% else %}
                                <li>No order items recorded.</li>
                            {% endfor %}
                            </ul>
                            <dl class="order-detail-grid">
                                <div><dt>Order total</dt><dd>₱{{ order.orderTotal|number_format(2) }}</dd></div>
                                <div><dt>Order status</dt><dd><span class="badge {{ order.displayStatus == 'Completed' ? 'badge-success' : (order.displayStatus == 'Cancelled' ? 'badge-danger' : 'badge-warning') }}" data-order-status-detail>{{ order.displayStatus }}</span></dd></div>
                                <div><dt>Payment method</dt><dd>{{ order.paymentMethod|default('Not recorded') }}</dd></div>
                                <div><dt>Payment status</dt><dd>{{ order.paymentStatus }}</dd></div>
                                <div><dt>Payment reference</dt><dd>{{ order.paymentReference|default('Not recorded') }}</dd></div>
                                <div><dt>Payment verified</dt><dd>{{ order.paymentVerifiedAt ? order.paymentVerifiedAt|date('M j, Y · g:i A') : 'Not verified' }}</dd></div>
                                <div class="order-detail-full" data-order-cancellation-row {{ not order.cancellationReason ? 'hidden' : '' }}><dt>Cancellation reason</dt><dd data-order-cancellation-reason>{{ order.cancellationReason|default('') }}</dd></div>
                            </dl>
                        </section>
                    </div>
                </dialog>
                {% if canModifyOrder and order.currentStatus not in ['Completed', 'Cancellation Pending'] %}
                <dialog class="order-details-modal {{ isAdminOrdersPage ? 'admin-order-edit-dialog' : 'staff-order-dialog' }}" id="order-edit-details-{{ groupId }}" aria-labelledby="order-edit-details-title-{{ groupId }}">
                    <div class="order-details-modal-header">
                        <div>
                            <p class="admin-edit-eyebrow">Order management</p>
                            <h3 id="order-edit-details-title-{{ groupId }}">Edit Order #{{ groupId }}</h3>
                        </div>
                        <button class="btn-sm btn-secondary" type="button" data-close-order-details aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </div>
                    <div class="order-details-body">
                        <p class="admin-edit-intro">Customer and product information is read-only. Update the order status{% if showPaymentVerification|default(false) %} or verify a pending payment{% endif %} below.</p>
                        {% if order.currentStatus not in ['Completed', 'Cancellation Pending'] %}
                            {% set statusOptions = ['Pending', 'Completed', 'Cancelled'] %}
                            <form method="post" action="{{ path(statusRoute, {id: groupId}) }}" class="order-update-form order-status-form {{ isAdminOrdersPage ? 'admin-order-status-form' : '' }}" data-order-id="{{ groupId }}" data-deferred-cancel-status="Cancelled" data-confirm-message="Cancel order #{{ groupId }}? The change will be applied after the 3-second Undo window.">
                                <input type="hidden" name="_token" value="{{ csrf_token(statusTokenPrefix ~ '_' ~ groupId) }}">
                                <label class="admin-order-status-label">Update order status
                                    <select class="form-control" name="status" required data-order-status data-current-status="{{ order.currentStatus }}" data-initial-status="{{ order.displayStatus }}">
                                        {% for option in statusOptions %}
                                            {% set disabledOption = (order.currentStatus == 'Cancelled' and option == 'Completed') or (order.currentStatus == 'Shipped' and option == 'Cancelled') %}
                                            <option value="{{ option }}" {{ order.displayStatus == option ? 'selected' : '' }} {{ disabledOption ? 'disabled' : '' }}>{{ option }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                                <label class="cancellation-reason {{ isAdminOrdersPage ? 'admin-order-cancellation-reason' : '' }}" data-cancellation-reason-field>
                                    Cancellation reason
                                    <textarea class="form-control" name="cancellationReason" maxlength="500">{{ order.cancellationReason }}</textarea>
                                </label>
                                <button type="submit" class="btn-primary">Save status</button>
                            </form>
                        {% endif %}
                        {% if showPaymentVerification|default(false) and order.paymentStatus == 'Pending' and order.currentStatus != 'Cancelled' %}
                            <form method="post" action="{{ path(paymentVerifyRoute, {id: groupId}) }}" class="order-payment-form" data-confirm-payment>
                                <input type="hidden" name="_token" value="{{ csrf_token(paymentVerifyRoute ~ '_' ~ groupId) }}">
                                <button type="submit" class="btn-secondary"><i class="fas fa-check" aria-hidden="true"></i> Confirm payment received</button>
                            </form>
                        {% endif %}
                    </div>
                </dialog>
                {% endif %}
                </td></tr>
            {% else %}
                <tr><td colspan="8">No customer orders match these filters.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <nav class="order-pagination" aria-label="Order pages">
            <span>Page {{ page }} of {{ totalPages }} · {{ totalOrders }} orders</span>
            {% if page > 1 %}
                <a href="{{ path(app.request.attributes.get('_route'), {search: filters.search, status: filters.status, payment_status: filters.paymentStatus, date_from: filters.dateFrom, date_to: filters.dateTo, page: page - 1}) }}">Previous</a>
            {% endif %}
            {% if page < totalPages %}
                <a href="{{ path(app.request.attributes.get('_route'), {search: filters.search, status: filters.status, payment_status: filters.paymentStatus, date_from: filters.dateFrom, date_to: filters.dateTo, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
    {% if isAdminOrdersPage and createRoute %}
        <dialog id="orderCreateDialog" class="admin-edit-dialog" aria-labelledby="orderCreateTitle">
            <div id="orderCreateContent"></div>
        </dialog>
    {% endif %}
    </div>
</main>
<script>
    const orderCreateButton = document.querySelector('[data-order-create-url]');
    const orderCreateDialog = document.getElementById('orderCreateDialog');
    const orderCreateContent = document.getElementById('orderCreateContent');
    const orderCreateNotify = (message, type) => {
        if (typeof window.showAdminToast === 'function') window.showAdminToast(message, type);
        else console.error(message);
    };

    if (orderCreateButton && orderCreateDialog && orderCreateContent) {
        orderCreateButton.addEventListener('click', async () => {
            try {
                const response = await fetch(orderCreateButton.dataset.orderCreateUrl, {
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                    credentials: 'same-origin'
                });
                if (!response.ok) throw new Error(`Order form could not be loaded (${response.status}).`);
                orderCreateContent.innerHTML = await response.text();
                orderCreateDialog.showModal();
            } catch (error) {
                console.error('Unable to load the order form.', error);
                orderCreateNotify(error.message || 'Unable to load the order form.', 'error');
            }
        });

        orderCreateDialog.addEventListener('click', (event) => {
            if (event.target.closest('[data-close-order-create]')) orderCreateDialog.close();
            const removeButton = event.target.closest('[data-remove-order-item]');
            if (removeButton) {
                const items = orderCreateContent.querySelector('#orderCreateItems');
                if (items && items.children.length > 1) removeButton.closest('[data-order-item]').remove();
            }
            if (!event.target.closest('#addOrderItem')) return;
            const items = orderCreateContent.querySelector('#orderCreateItems');
            if (!items) return;
            if (items.children.length >= 20) {
                orderCreateNotify('An order can contain at most 20 line items.', 'error');
                return;
            }
            const indices = [...items.querySelectorAll('input, select')].map((field) => {
                const match = field.name.match(/\[items\]\[(\d+)\]/);
                return match ? Number(match[1]) : -1;
            });
            const nextIndex = Math.max(-1, ...indices) + 1;
            const template = items.dataset.prototype.replaceAll('__name__', String(nextIndex));
            const wrapper = document.createElement('div');
            wrapper.innerHTML = template;
            items.append(wrapper.firstElementChild);
        });

        orderCreateDialog.addEventListener('submit', async (event) => {
            const form = event.target.closest('#orderCreateForm');
            if (!form) return;
            event.preventDefault();
            const submitButton = event.submitter;
            if (form.dataset.submitting === 'true') return;
            form.dataset.submitting = 'true';
            if (submitButton) submitButton.disabled = true;
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    credentials: 'same-origin'
                });
                const result = await response.json();
                if (!response.ok || result.success !== true) throw new Error(result.message || `Order creation failed (${response.status}).`);
                orderCreateDialog.close();
                orderCreateNotify(result.message || 'Order created.', 'success');
                window.setTimeout(() => window.location.reload(), 700);
            } catch (error) {
                console.error('Unable to create the order.', error);
                orderCreateNotify(error.message || 'Unable to create the order.', 'error');
            } finally {
                form.dataset.submitting = 'false';
                if (submitButton) submitButton.disabled = false;
            }
        });
    }

    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const closeButton = target.closest('[data-close-order-details]');
        if (closeButton) {
            closeButton.closest('dialog')?.close();
            return;
        }
        const viewButton = target.closest('[data-open-order-details]');
        const editButton = target.closest('[data-edit-order-details]');
        const button = viewButton || editButton;
        if (!button) return;
        const dialog = document.getElementById(button.dataset.openOrderDetails || button.dataset.editOrderDetails);
        if (!dialog) return;
        dialog.showModal();
        if (editButton) dialog.querySelector('[data-order-status]')?.focus();
    });

    document.querySelectorAll('.order-status-form').forEach((form) => {
        const status = form.querySelector('select[name="status"]');
        const field = form.querySelector('[data-cancellation-reason-field]');
        const reason = field.querySelector('textarea');
        const updateReasonRequirement = () => {
            field.hidden = status.value !== 'Cancelled';
            reason.required = status.value === 'Cancelled' && status.value !== status.dataset.initialStatus;
        };
        status.addEventListener('change', updateReasonRequirement);
        updateReasonRequirement();
    });

    document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)
            || !form.matches('.order-status-form')
            || (!document.body.classList.contains('admin-page') && !document.body.classList.contains('staff-page'))) return;

        const status = form.querySelector('select[name="status"]');
        if (!status) return;
        if (status.value === form.dataset.deferredCancelStatus
            && status.value !== status.dataset.initialStatus
            && form.dataset.deferredSubmit !== 'true') return;

        event.preventDefault();
        if (form.dataset.statusSubmitting === 'true') return;
        form.dataset.statusSubmitting = 'true';
        form.dataset.submitting = 'true';
        const submitButtons = [...form.querySelectorAll('button[type="submit"]')];
        const wasDisabled = submitButtons.map((button) => button.disabled);
        submitButtons.forEach((button) => { button.disabled = true; });

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin'
            });
            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                throw new Error(`Order status update failed (${response.status}).`);
            }
            const result = await response.json();
            if (!response.ok || result.success !== true || String(result.id) !== form.dataset.orderId) {
                throw new Error(result.message || `Order status update failed (${response.status}).`);
            }

            const detailsRow = form.closest('tr.order-details-row');
            const summaryRow = detailsRow?.previousElementSibling;
            const badge = summaryRow?.querySelector('[data-order-status-label]');
            if (!badge) throw new Error('The updated order row could not be found.');

            const displayStatus = result.status;
            badge.textContent = displayStatus;
            badge.className = `badge ${displayStatus === 'Completed' ? 'badge-success' : (displayStatus === 'Cancelled' ? 'badge-danger' : 'badge-warning')}`;
            const detailStatus = detailsRow?.querySelector('[data-order-status-detail]');
            if (detailStatus) {
                detailStatus.textContent = displayStatus;
                detailStatus.className = `badge ${displayStatus === 'Completed' ? 'badge-success' : (displayStatus === 'Cancelled' ? 'badge-danger' : 'badge-warning')}`;
            }
            const cancellationRow = detailsRow?.querySelector('[data-order-cancellation-row]');
            const cancellationReason = detailsRow?.querySelector('[data-order-cancellation-reason]');
            if (cancellationRow && cancellationReason) {
                cancellationReason.textContent = result.cancellationReason || '';
                cancellationRow.hidden = !result.cancellationReason;
            }
            status.value = displayStatus;
            status.dataset.currentStatus = displayStatus;
            status.dataset.initialStatus = displayStatus;
            const reasonField = form.querySelector('[data-cancellation-reason-field]');
            const reason = reasonField?.querySelector('textarea');
            if (reasonField && reason) {
                reasonField.hidden = displayStatus !== 'Cancelled';
                reason.required = false;
            }
            Object.entries(result.counts || {}).forEach(([key, count]) => {
                const value = document.querySelector(`[data-order-count="${key}"] .stat-info h3`);
                if (value) value.textContent = String(count);
            });
            const editDialog = form.closest('dialog');
            editDialog?.close();
            if (displayStatus === 'Completed') {
                summaryRow.querySelector('[data-edit-order-details]')?.remove();
                editDialog?.remove();
            }
            if (typeof window.showAdminToast === 'function') window.showAdminToast(result.message || 'Order status updated.', 'success');
        } catch (error) {
            console.error('Unable to update the order status.', error);
            if (typeof window.showAdminToast === 'function') window.showAdminToast(error.message || 'Unable to update the order status.', 'error');
        } finally {
            form.dataset.statusSubmitting = 'false';
            form.dataset.submitting = 'false';
            submitButtons.forEach((button, index) => { button.disabled = wasDisabled[index]; });
        }
    });
</script>
<script>
    document.querySelectorAll('.order-filters [data-auto-submit]').forEach((filter) => {
        filter.addEventListener('change', () => filter.form?.requestSubmit());
    });
</script>
