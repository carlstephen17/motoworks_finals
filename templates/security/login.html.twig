{% extends 'base.html.twig' %}

{% block title %}Sign In - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/login_style.css') }}">
{% endblock %}

{% block body %}
    <main class="container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 40px 20px;">
        <div class="auth-card">
            <h2 style="text-align: center; margin-bottom: 12px; color: #fff;">Sign In to Your Account</h2>
            <p style="text-align: center; color: #94a3b8;">Continue in the sign-in dialog.</p>
            {% if error %}
                <div id="login-page-auth-error" class="alert-error" role="alert" hidden>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
