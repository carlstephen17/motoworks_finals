{% extends 'base.html.twig' %}

{% block title %}Sign In - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/login_style.css') }}">
{% endblock %}

{% block body %}
    <main class="container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 40px 20px;">
        <div class="auth-card">
            <h2 style="text-align: center; margin-bottom: 24px; color: #fff;">Sign In to Your Account</h2>

            {% for message in app.flashes('error') %}
                <div class="alert alert-error" style="background: rgba(220, 53, 69, 0.2); color: #ea868f; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem;">
                    {{ message }}
                </div>
            {% endfor %}

            {% if error %}
                <div class="alert alert-error" style="background: rgba(220, 53, 69, 0.2); color: #ea868f; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div>
                    <label for="username" style="display: block; margin-bottom: 6px; font-size: 0.85rem; color: #94a3b8;">Username or Email</label>
                    <input id="username" type="text" name="username" value="{{ last_username }}" required autofocus autocomplete="username" class="auth-input" placeholder="Enter username or email">
                </div>

                <div>
                    <label for="password" style="display: block; margin-bottom: 6px; font-size: 0.85rem; color: #94a3b8;">Password</label>
                    <input id="password" type="password" name="password" required autocomplete="current-password" class="auth-input" placeholder="Enter password">
                </div>

                <div class="auth-options" style="display: flex; justify-content: space-between; align-items: center; margin: 8px 0;">
                    <a href="{{ path('password_forgot') }}" style="color: var(--color-primary, #00bcd4); font-size: 0.85rem; text-decoration: none;">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary auth-btn" style="width: 100%; padding: 12px; font-weight: 600; cursor: pointer;">Sign In</button>
            </form>

            <div style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: #94a3b8;">
                Don't have an account? <a href="{{ path('app_register') }}" style="color: var(--color-primary, #00bcd4); text-decoration: none;">Sign up here</a>
            </div>
        </div>
    </main>
{% endblock %}
