{% extends 'base.html.twig' %}

{% block title %}Reset Password - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/forgot_style.css') }}">
{% endblock %}

{% block body %}
    <main class="container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 40px 20px;">
        <div class="auth-card">
            <h2 style="margin-bottom: 12px; color: #fff;">Create New Password</h2>

            {% for message in app.flashes('success') %}
                <div class="auth-message" style="background: rgba(46, 213, 115, 0.15); border: 1px solid #2ed573; padding: 12px; border-radius: 6px; margin-bottom: 16px;">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div style="background: rgba(220, 53, 69, 0.2); color: #ea868f; border: 1px solid #dc3545; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem;">
                    {{ message }}
                </div>
            {% endfor %}

            {% if validToken %}
                {{ form_start(form, {action: path('password_reset', {token: token}), 'attr': {'id': 'reset-password-form', 'class': 'auth-form'}}) }}
                    {{ form_errors(form) }}
                    <div>
                        <label for="{{ form.password.vars.id }}" style="display: block; text-align: left; margin-bottom: 6px; font-size: 0.85rem; color: #94a3b8;">New Password</label>
                        {{ form_widget(form.password, {'attr': {'class': 'auth-input', 'placeholder': 'Enter new password (min. 8 characters)'}}) }}
                        {{ form_errors(form.password) }}
                    </div>

                    {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary auth-btn', 'style': 'width: 100%; padding: 12px; font-weight: 600; cursor: pointer;'}}) }}
                {{ form_end(form) }}
            {% else %}
                <div style="background: rgba(220, 53, 69, 0.2); color: #ea868f; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                    <p style="margin: 0;">This password reset link is invalid or has expired.</p>
                </div>
            {% endif %}

            <div style="margin-top: 24px;">
                <a href="{{ path('app_login') }}" style="color: var(--color-primary, #00bcd4); text-decoration: none; font-size: 0.9rem;">&larr; Return to Sign In</a>
            </div>
        </div>
    </main>
{% endblock %}
