<dialog id="panel-action-confirmation-modal" class="cancellation-modal" aria-hidden="true" aria-labelledby="panel-action-confirmation-title">
    <section class="cancellation-modal-card">
        <h2 id="panel-action-confirmation-title" data-panel-action-title>Confirm action</h2>
        <p data-panel-action-message></p>
        <div class="cancellation-modal-actions">
            <button type="button" class="cancellation-button-secondary" data-panel-action-no>No</button>
            <button type="button" class="cancellation-button-primary" data-panel-action-yes>Yes</button>
        </div>
    </section>
</dialog>
<div id="panel-action-notifications" class="history-notifications" popover="manual" role="region" aria-label="Pending administrative actions" aria-live="polite"></div>
<div id="panel-action-toast-container" class="history-toast-container" popover="manual" role="region" aria-label="Administrative action notifications" aria-live="polite"></div>
