{% extends 'base.html.twig' %}
{% block site_header %}{% include 'staff/_nav.html.twig' %}{% endblock %}
{% block title %}Appointments | Staff{% endblock %}
{% block body %}
<main>
    <h1>Appointments</h1>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
    <p><a href="{{ path('staff_appointment_new') }}">Create appointment</a></p>
    <section aria-label="Appointment totals">
        <p>Total: {{ counts.total }}</p>
        <p>Pending: {{ counts.pending }}</p>
        <p>Completed: {{ counts.completed }}</p>
        <p>Cancelled: {{ counts.cancelled }}</p>
    </section>
    <form method="get" action="{{ path('staff_appointments') }}">
        <label for="appointmentSearch">Search by customer, vehicle, service, or appointment ID</label>
        <input id="appointmentSearch" type="search" name="search" value="{{ filters.search }}">
        <label for="appointmentStatus">Status</label>
        <select id="appointmentStatus" name="status">
            <option value="">All statuses</option>
            {% for option in ['Pending', 'Cancelled', 'Completed'] %}
                <option value="{{ option }}" {{ filters.status == option ? 'selected' : '' }}>{{ option }}</option>
            {% endfor %}
        </select>
        <label for="appointmentDate">Date</label>
        <input id="appointmentDate" type="date" name="date" value="{{ filters.date }}">
        <label for="appointmentSource">Booking source</label>
        <select id="appointmentSource" name="source">
            <option value="">All sources</option>
            <option value="online" {{ filters.source == 'online' ? 'selected' : '' }}>Customer online</option>
            <option value="staff" {{ filters.source == 'staff' ? 'selected' : '' }}>Staff</option>
            <option value="admin" {{ filters.source == 'admin' ? 'selected' : '' }}>Admin</option>
        </select>
        <button type="submit">Filter</button>
        <a href="{{ path('staff_appointments') }}">Clear</a>
    </form>

    <table>
        <thead><tr><th>Appointment</th><th>Customer</th><th>Service</th><th>Motorcycle</th><th>Source</th><th>Status</th><th>Notes</th><th>Actions</th></tr></thead>
        <tbody>
        {% for booking in bookings %}
            <tr>
                <td>#{{ booking.id }}<br>{{ booking.bookingDate|date('M j, Y') }} {{ booking.bookingTime|date('g:i A') }}</td>
                <td>{{ booking.user.firstName }} {{ booking.user.lastName }}<br>{{ booking.user.email }}<br>{{ booking.user.phone }}</td>
                <td>{{ booking.service.name }}</td>
                <td>{{ booking.vehicleModel }}{% if booking.motorcycle and booking.motorcycle.plateNumber %}<br>{{ booking.motorcycle.plateNumber }}{% endif %}</td>
                <td>{{ booking.source|default('Not recorded') }}{% if booking.createdByStaff %}<br>{{ booking.createdByStaff.firstName }} {{ booking.createdByStaff.lastName }}{% endif %}</td>
                <td>{{ booking.status }}</td>
                <td>{{ booking.notes }}{% if booking.rejectionReason %}<br>{{ booking.rejectionReason }}{% endif %}</td>
                <td>
                    <a href="{{ path('staff_appointment_edit', {id: booking.id}) }}">Edit details</a>
                    {% if booking.status != 'Completed' %}
                        <form method="post" action="{{ path('staff_appointment_update', {id: booking.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('staff_appointment_update_' ~ booking.id) }}">
                            <select name="status">
                                {% for option in ['Pending', 'Confirmed', 'Completed', 'Cancelled', 'Rejected'] %}
                                    <option value="{{ option }}" {{ booking.status == option ? 'selected' : '' }}>{{ option }}</option>
                                {% endfor %}
                            </select>
                            <label>Cancellation reason
                                <textarea name="rejectionReason" maxlength="1000">{{ booking.rejectionReason }}</textarea>
                            </label>
                            <button type="submit">Update status</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('staff_appointment_delete', {id: booking.id}) }}" onsubmit="return confirm('Delete this appointment?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('staff_appointment_delete_' ~ booking.id) }}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8">No appointments found for these filters.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</main>
{% endblock %}
