{% extends 'base.html.twig' %}
{% block site_header %}{% include 'staff/_nav.html.twig' %}{% endblock %}
{% block site_footer %}{% endblock %}
{% block title %}Staff dashboard | Bencalo MotoWorks{% endblock %}
{% block body %}
<main class="admin-main">
    {% include 'staff/_header.html.twig' with {title: 'Staff Dashboard'} %}
    <div class="admin-content-body">
        {% for message in app.flashes('success') %}<p role="status" class="alert-toast" data-auto-dismiss>{{ message }}</p>{% endfor %}
        {% for message in app.flashes('error') %}<p role="alert" class="alert-toast alert-error" data-auto-dismiss>{{ message }}</p>{% endfor %}

        <section class="management-overview" aria-label="Business overview">
            <div class="management-section">
                <div class="management-section-heading">
                    <h3>Inventory &amp; Catalog</h3>
                </div>
                <div class="management-count-grid management-count-grid-three">
                    <div class="management-count-card">
                        <span class="management-count-label">Total Products</span>
                        <strong data-dashboard-count="products">{{ counts.products }}</strong>
                    </div>
                </div>
            </div>

            <div class="management-section">
                <div class="management-section-heading">
                    <h3>Operations &amp; Business</h3>
                </div>
                <div class="management-count-grid management-count-grid-three">
                    <a class="management-count-card" href="{{ path('staff_orders') }}">
                        <span class="management-count-label">Total Orders</span>
                        <strong data-dashboard-count="orders">{{ counts.orders }}</strong>
                    </a>
                    <a class="management-count-card" href="{{ path('staff_appointments') }}">
                        <span class="management-count-label">Total Service Appointments</span>
                        <strong data-dashboard-count="appointments">{{ counts.appointments }}</strong>
                    </a>
                    <a class="management-count-card" href="{{ path('staff_promo_history') }}">
                        <span class="management-count-label">Total Promo History</span>
                        <strong data-dashboard-count="promoClaims">{{ counts.promoClaims }}</strong>
                    </a>
                    <div class="management-count-card">
                        <span class="management-count-label">Total Records</span>
                        <strong data-dashboard-count="totalRecords">{{ counts.totalRecords }}</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="dashboard-activity-grid" aria-label="Recent activity" style="margin-top: 24px;">
            <article class="dashboard-activity-panel">
                <header class="dashboard-activity-heading">
                    <h3>Recent Orders</h3>
                    <a href="{{ path('staff_orders') }}">View all</a>
                </header>
                {% if recentOrders is defined and recentOrders is not empty %}
                    <ul class="dashboard-activity-list">
                        {% for order in recentOrders %}
                            {% set orderId = order.orderGroupId %}
                            {% set activityStatus = order.displayStatus %}
                            <li>
                                <div class="dashboard-activity-item-heading">
                                    <a href="{{ path('staff_orders') }}">Order #{{ orderId }}</a>
                                    <span class="dashboard-activity-status dashboard-activity-status--{{ activityStatus|lower|replace({' ': '-'}) }}">{{ activityStatus }}</span>
                                </div>
                                <span class="dashboard-activity-description">{{ order.firstName }} {{ order.lastName }} · {{ order.itemCount }} item(s)</span>
                                <div class="dashboard-activity-meta">
                                    <time datetime="{{ order.createdAt|date('c') }}">{{ order.createdAt|date('M j, Y') }}</time>
                                    <strong>₱{{ order.orderTotal|number_format(2) }}</strong>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="dashboard-activity-empty">No orders recorded yet.</p>
                {% endif %}
            </article>

            <article class="dashboard-activity-panel">
                <header class="dashboard-activity-heading">
                    <h3>Recent Appointments</h3>
                    <a href="{{ path('staff_appointments') }}">View all</a>
                </header>
                {% if recentAppointments is defined and recentAppointments is not empty %}
                    <ul class="dashboard-activity-list">
                        {% for booking in recentAppointments %}
                            {% set activityStatus = booking.status in ['Confirmed', 'Cancellation Pending'] ? 'Pending' : (booking.status == 'Rejected' ? 'Cancelled' : booking.status|default('Pending')) %}
                            <li>
                                <div class="dashboard-activity-item-heading">
                                    <a href="{{ path('staff_appointments') }}">Appointment #{{ booking.id }}</a>
                                    <span class="dashboard-activity-status dashboard-activity-status--{{ activityStatus|lower|replace({' ': '-'}) }}">{{ activityStatus }}</span>
                                </div>
                                <span class="dashboard-activity-description">{{ booking.user.firstName }} {{ booking.user.lastName }} · {{ booking.service.name }}</span>
                                <div class="dashboard-activity-meta">
                                    <time datetime="{{ booking.bookingDate|date('c') }}">{{ booking.bookingDate|date('M j, Y') }} · {{ booking.bookingTime|date('g:i A') }}</time>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="dashboard-activity-empty">No appointments recorded yet.</p>
                {% endif %}
            </article>

            <article class="dashboard-activity-panel">
                <header class="dashboard-activity-heading">
                    <h3>Recent Promo Claims</h3>
                    <a href="{{ path('staff_promo_history') }}">View all</a>
                </header>
                {% if recentPromoClaims is defined and recentPromoClaims is not empty %}
                    <ul class="dashboard-activity-list">
                        {% for claim in recentPromoClaims %}
                            {% set activityStatus = claim.status|default('Pending') %}
                            <li>
                                <div class="dashboard-activity-item-heading">
                                    <a href="{{ path('staff_promo_history') }}">Claim #{{ claim.id }}</a>
                                    <span class="dashboard-activity-status dashboard-activity-status--{{ activityStatus|lower|replace({' ': '-'}) }}">{{ activityStatus }}</span>
                                </div>
                                <span class="dashboard-activity-description">{{ claim.fullName }} · {{ claim.promo ? claim.promo.title : claim.bundleSlug }}</span>
                                <div class="dashboard-activity-meta">
                                    <time datetime="{{ claim.createdAt|date('c') }}">{{ claim.createdAt|date('M j, Y') }}</time>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="dashboard-activity-empty">No promo claims recorded yet.</p>
                {% endif %}
            </article>
        </section>
    </div>
</main>
{% endblock %}
