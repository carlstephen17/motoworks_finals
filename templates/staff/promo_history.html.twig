{% extends 'base.html.twig' %}
{% block site_header %}{% include 'staff/_nav.html.twig' %}{% endblock %}
{% block title %}Promotion history | Staff{% endblock %}
{% block body %}
<main>
    <h1>Promotion claims</h1>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
    <p><a href="{{ path('staff_promo_claim_new') }}">Create claim</a></p>
    {% for claim in claims %}
        <article><h2>{{ claim.bundleSlug }} — {{ claim.selectedOption }}</h2><p>{{ claim.fullName }} · {{ claim.phone }} · {{ claim.appointmentDate|date('M j, Y') }} · {{ claim.status }}</p>
            <a href="{{ path('staff_promo_claim_edit', {id: claim.id}) }}">Edit claim details</a>
            <form method="post" action="{{ path('staff_promo_claim_update', {id: claim.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('staff_promo_claim_' ~ claim.id) }}"><select name="status">{% for status in ['Pending','Confirmed','Used','Completed','Cancelled'] %}<option {{ claim.status == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select><button>Update</button></form>
            <form method="post" action="{{ path('staff_promo_claim_delete', {id: claim.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('staff_promo_claim_' ~ claim.id) }}"><button>Delete</button></form>
        </article>
    {% else %}<p>No promotion claims.</p>{% endfor %}
</main>
{% endblock %}
