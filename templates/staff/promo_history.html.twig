{% extends 'base.html.twig' %}
{% block site_header %}{% include 'staff/_nav.html.twig' %}{% endblock %}
{% block title %}Promotion history | Staff{% endblock %}
{% block body %}
<main class="admin-main">
    {% include 'staff/_header.html.twig' with {title: 'Promotion Claims'} %}
    <div class="admin-content-body">
        {% for message in app.flashes('success') %}<p role="status" class="alert-toast" data-auto-dismiss>{{ message }}</p>{% endfor %}
        {% for message in app.flashes('error') %}<p role="alert" class="alert-toast alert-error" data-auto-dismiss>{{ message }}</p>{% endfor %}

        <section class="order-stats" aria-label="Promotion claim totals">
            <article class="stat-card" data-promo-count="total">
                <div class="stat-info">
                    <h3>{{ counts.total }}</h3>
                    <p>All claims: {{ counts.total }}</p>
                </div>
            </article>
            <article class="stat-card" data-promo-count="pending">
                <div class="stat-info">
                    <h3>{{ counts.pending }}</h3>
                    <p>Pending</p>
                </div>
            </article>
            <article class="stat-card" data-promo-count="completed">
                <div class="stat-info">
                    <h3>{{ counts.completed }}</h3>
                    <p>Completed</p>
                </div>
            </article>
            <article class="stat-card" data-promo-count="cancelled">
                <div class="stat-info">
                    <h3>{{ counts.cancelled }}</h3>
                    <p>Cancelled</p>
                </div>
            </article>
        </section>

        <form id="promoClaimFilters" class="table-filters" method="get" action="{{ path('staff_promo_history') }}" data-auto-filter>
            <label class="visually-hidden" for="claimSearch">Search</label>
            <input id="claimSearch" type="search" name="search" value="{{ search }}" placeholder="Search customer, phone, promo, or option..." autocomplete="off">

            <label class="visually-hidden" for="claimStatus">Status</label>
            <select id="claimStatus" name="status">
                <option value="">All statuses</option>
                {% for option in ['Pending', 'Completed', 'Cancelled'] %}
                    <option value="{{ option }}" {{ status == option ? 'selected' : '' }}>{{ option }}</option>
                {% endfor %}
            </select>

            <a class="btn-primary" href="{{ path('staff_promo_claim_new') }}"><i class="fas fa-plus" aria-hidden="true"></i> Create Claim</a>
        </form>

        <div class="table-responsive">
            <table class="admin-table" id="promoClaimTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Promotion &amp; Option</th>
                        <th>Appointment Date &amp; Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for claim in claims %}
                    {% set claimDisplayStatus = claim.status == 'Completed' ? 'Completed' : (claim.status == 'Cancelled' ? 'Cancelled' : 'Pending') %}
                    {% set canModify = is_granted('ROLE_ADMIN') or not claim.createdByStaff or claim.createdByStaff.id == app.user.id %}
                    {% set claimDetails = {
                        id: 'PC-' ~ claim.id,
                        fullName: claim.fullName,
                        phone: claim.phone|default('N/A'),
                        promotion: claim.promo ? claim.promo.title : claim.bundleSlug,
                        bundle: claim.bundleSlug,
                        selectedOption: claim.selectedOption,
                        appointmentDate: claim.appointmentDate|date('M j, Y'),
                        appointmentTime: claim.appointmentTime|date('g:i A'),
                        status: claimDisplayStatus,
                        creator: claim.createdByStaff ? (claim.createdByStaff.firstName ~ ' ' ~ claim.createdByStaff.lastName) : 'Customer Online',
                        account: claim.user ? claim.user.username : 'Guest claim',
                        email: claim.user ? claim.user.email : '—',
                        createdAt: claim.createdAt|date('M j, Y g:i A'),
                        csrfToken: csrf_token('staff_promo_claim_edit_' ~ claim.id),
                        edit: {
                            bundleSlug: claim.bundleSlug,
                            selectedOption: claim.selectedOption,
                            appointmentDate: claim.appointmentDate|date('Y-m-d'),
                            appointmentTime: claim.appointmentTime|date('H:i'),
                            status: claimDisplayStatus
                        }
                    } %}
                    <tr class="promo-claim-row" data-id="{{ claim.id }}">
                        <td><strong>#{{ claim.id }}</strong></td>
                        <td>
                            <strong>{{ claim.fullName }}</strong><br>
                            <small class="text-muted">{{ claim.phone|default('N/A') }}</small>
                            {% if claim.user %}<br><small class="text-muted">@{{ claim.user.username }}</small>{% endif %}
                        </td>
                        <td data-claim-promotion>
                            <strong>{{ claim.promo ? claim.promo.title : claim.bundleSlug }}</strong><br>
                            <small class="text-muted" data-claim-option>{{ claim.selectedOption }}</small>
                        </td>
                        <td data-claim-schedule>
                            <span data-claim-date>{{ claim.appointmentDate|date('M j, Y') }}</span><br>
                            <small class="text-muted" data-claim-time>{{ claim.appointmentTime|date('g:i A') }}</small>
                        </td>
                        <td>
                            <span class="badge {{ claimDisplayStatus == 'Pending' ? 'badge-warning' : (claimDisplayStatus == 'Completed' ? 'badge-success' : 'badge-danger') }}" data-claim-status>
                                {{ claimDisplayStatus }}
                            </span>
                        </td>
                        <td class="table-row-actions">
                            <button type="button" class="btn-sm btn-secondary view-promo-claim" data-claim="{{ claimDetails|json_encode|e('html_attr') }}">
                                <i class="fas fa-eye" aria-hidden="true"></i> View
                            </button>
                            {% if canModify and claim.status not in ['Completed', 'Cancellation Pending'] %}
                                <button type="button" class="btn-sm btn-info edit-promo-claim" data-edit-promo-claim data-claim="{{ claimDetails|json_encode|e('html_attr') }}" data-edit-url="{{ path('staff_promo_claim_edit', {id: claim.id}) }}">
                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">No promo claims match these filters.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <dialog id="staffPromoClaimDetails" class="order-details-modal staff-order-dialog" aria-labelledby="staffPromoClaimDetailsTitle">
            <div class="order-details-modal-header">
                <h3 id="staffPromoClaimDetailsTitle">Promotion Claim Details</h3>
                <button class="btn-sm btn-danger" type="button" data-close-promo-details aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="order-details-body">
                <section class="order-detail-section">
                    <h4>Claim and customer</h4>
                    <dl class="order-detail-grid">
                        <div><dt>Claim ID</dt><dd data-detail="id"></dd></div>
                        <div><dt>Created</dt><dd data-detail="createdAt"></dd></div>
                        <div><dt>Customer</dt><dd data-detail="fullName"></dd></div>
                        <div><dt>Account</dt><dd data-detail="account"></dd></div>
                        <div><dt>Email</dt><dd data-detail="email"></dd></div>
                        <div><dt>Phone</dt><dd data-detail="phone"></dd></div>
                        <div><dt>Created by</dt><dd data-detail="creator"></dd></div>
                    </dl>
                </section>
                <section class="order-detail-section">
                    <h4>Promotion and appointment</h4>
                    <dl class="order-detail-grid">
                        <div><dt>Promotion</dt><dd data-detail="promotion"></dd></div>
                        <div><dt>Promotion code</dt><dd data-detail="bundle"></dd></div>
                        <div><dt>Selected option</dt><dd data-detail="selectedOption"></dd></div>
                        <div><dt>Appointment date</dt><dd data-detail="appointmentDate"></dd></div>
                        <div><dt>Appointment time</dt><dd data-detail="appointmentTime"></dd></div>
                        <div><dt>Status</dt><dd><span class="badge" data-detail="status"></span></dd></div>
                    </dl>
                </section>
            </div>
        </dialog>

        <dialog id="staffPromoClaimEdit" class="staff-edit-dialog" aria-labelledby="staffPromoClaimEditTitle">
            <form method="post" class="staff-edit-form" data-promo-claim-edit-form>
                <div class="staff-edit-header">
                    <div>
                        <p class="staff-edit-eyebrow">Promotion history</p>
                        <h3 id="staffPromoClaimEditTitle">Edit Promotion Claim</h3>
                    </div>
                    <button type="button" class="close-btn" data-close-promo-edit aria-label="Close">×</button>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('staff_promo_claim_edit_0') }}" data-promo-csrf>
                <div class="staff-edit-body">
                    <section class="staff-edit-section">
                        <h4>Promotion selection</h4>
                        <div class="staff-edit-grid">
                            <label>Promotion
                                <select class="form-control" name="promo_claim_edit[bundleSlug]" required data-promo-field="bundleSlug">
                                    {% for promo in promos %}
                                        <option value="{{ promo.slug }}">{{ promo.title }}{{ promo.active ? '' : ' (Inactive)' }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>Selected option
                                <input class="form-control" type="text" name="promo_claim_edit[selectedOption]" maxlength="255" required data-promo-field="selectedOption">
                            </label>
                        </div>
                    </section>
                    <section class="staff-edit-section">
                        <h4>Appointment and status</h4>
                        <div class="staff-edit-grid">
                            <label>Appointment date
                                <input class="form-control" type="date" name="promo_claim_edit[appointmentDate]" required data-promo-field="appointmentDate">
                            </label>
                            <label>Appointment time
                                <input class="form-control" type="time" name="promo_claim_edit[appointmentTime]" required data-promo-field="appointmentTime">
                            </label>
                            <label>Status
                                <select class="form-control" name="promo_claim_edit[status]" required data-promo-field="status">
                                    {% for option in ['Pending', 'Completed', 'Cancelled'] %}
                                        <option value="{{ option }}">{{ option }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        </div>
                    </section>
                </div>
                <div class="staff-edit-footer">
                    <button type="button" class="btn-secondary" data-close-promo-edit>Cancel</button>
                    <button type="submit" class="btn-primary"><i class="fas fa-save" aria-hidden="true"></i> Save changes</button>
                </div>
            </form>
        </dialog>
    </div>
</main>
<script>
(() => {
    const dialog = document.getElementById('staffPromoClaimDetails');
    if (!dialog) return;

    document.addEventListener('click', (event) => {
        const viewBtn = event.target.closest('.view-promo-claim');
        if (viewBtn) {
            try {
                const data = JSON.parse(viewBtn.dataset.claim);
                Object.keys(data).forEach((key) => {
                    const el = dialog.querySelector(`[data-detail="${key}"]`);
                    if (el) {
                        el.textContent = data[key] || '—';
                        if (key === 'status') el.className = `badge ${data[key] === 'Completed' ? 'badge-success' : (data[key] === 'Cancelled' ? 'badge-danger' : 'badge-warning')}`;
                    }
                });
                if (typeof dialog.showModal === 'function') {
                    dialog.showModal();
                } else {
                    dialog.setAttribute('open', '');
                }
            } catch (err) {
                console.error(err);
                if (typeof window.showAdminToast === 'function') window.showAdminToast('Unable to load promotion details.', 'error');
            }
        }
        if (event.target.closest('[data-close-promo-details]')) {
            if (typeof dialog.close === 'function') {
                dialog.close();
            } else {
                dialog.removeAttribute('open');
            }
        }
    });
})();
</script>
{% endblock %}
