<section id="products" class="container section-padding-top">
    <div class="section-title">
        <h2>Featured Products</h2>
    </div>
    {% if products is not empty %}
        <div class="card-grid product-grid" id="featured-product-grid">
            {% for product in products %}
                <div
                    class="product-card"
                    data-name="{{ product.name|lower }}"
                    data-product-id="{{ product.id }}"
                    style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 25px; display: flex; flex-direction: column; justify-content: space-between;"
                >
                    <div class="product-image" style="height: 160px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
                        {% if product.image %}
                            <img src="{{ asset(product.image) }}" alt="{{ product.name }}" style="max-width: 100%; max-height: 160px; object-fit: contain;">
                        {% else %}
                            <i class="fa-solid fa-box-open" aria-hidden="true" style="font-size: 3rem; color: var(--color-text-muted, #a0a0a0);"></i>
                        {% endif %}
                    </div>

                    <h3 class="product-name" style="color: #fff; margin-bottom: 8px;">{{ product.name }}</h3>

                    <div class="product-price" style="color: #fff; font-size: 1.1rem; font-weight: 600; margin-bottom: 5px;">
                        ₱{{ product.price|number_format(2) }}
                    </div>

                    <div class="product-stock" data-stock-display style="font-size: 0.85rem; margin: 5px 0 15px 0; color: {{ product.stock > 0 ? '#2e7d32' : '#c62828' }};">
                        {% if product.stock > 0 %}Stock: <strong>{{ product.stock }}</strong> available{% else %}Out of Stock{% endif %}
                    </div>

                    <div class="product-card-actions" style="display: flex; gap: 10px;">
                        <button
                            type="button"
                            class="btn btn-outline btn-cart-add js-add-to-cart"
                            title="Add to Cart"
                            data-product-id="{{ product.id }}"
                            data-product-name="{{ product.name|e('html_attr') }}"
                            data-product-price="{{ product.price }}"
                            data-stock-limit="{{ product.stock }}"
                            data-csrf-token="{{ csrf_token('cart_add_' ~ product.id) }}"
                            style="flex: 0 0 50px; width: 50px; {{ product.stock <= 0 ? 'opacity: 0.5; cursor: not-allowed;' : '' }}"
                            {{ product.stock <= 0 ? 'disabled' : '' }}
                        >
                            <i class="fa-solid fa-cart-plus"></i>
                        </button>
                        <button
                            type="button"
                            class="btn {{ product.stock > 0 ? 'btn-primary' : 'btn-secondary' }} btn-block js-buy-now"
                            data-product-id="{{ product.id }}"
                            data-product-name="{{ product.name|e('html_attr') }}"
                            data-product-price="{{ product.price }}"
                            data-stock-limit="{{ product.stock }}"
                            data-csrf-token="{{ csrf_token('buy_now_' ~ product.id) }}"
                            style="flex: 1; {{ product.stock <= 0 ? 'background: #ccc; cursor: not-allowed; border-color: #ccc;' : '' }}"
                            {{ product.stock <= 0 ? 'disabled' : '' }}
                        >{{ product.stock > 0 ? 'Buy Now' : 'Out of Stock' }}</button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p style="text-align: center; color: rgba(255, 255, 255, 0.6); padding: 30px;">
            No featured products available at the moment.
        </p>
    {% endif %}
</section>
