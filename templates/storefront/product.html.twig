{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Bencalo MotoWorks{% endblock %}

{% block body %}
    <main data-product-id="{{ product.id }}">
        <h1>{{ product.name }}</h1>
        {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
        {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
        {% if product.image %}<img src="{{ asset(product.image) }}" alt="{{ product.name }}">{% endif %}
        <p>₱{{ product.price|number_format(2) }}</p>
        <p class="product-stock" data-stock-display>{{ product.stock > 0 ? product.stock ~ ' in stock' : 'Out of stock' }}</p>
        <form method="post" action="{{ path('cart_add', {id: product.id}) }}" class="product-detail-cart-form">
            <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
            <label>Quantity <input type="number" name="quantity" min="1" max="{{ product.stock }}" value="1" required></label>
            <button type="submit" {{ product.stock <= 0 ? 'disabled' : '' }}>Add to cart</button>
        </form>
        <button
            type="button"
            class="js-buy-now"
            data-product-id="{{ product.id }}"
            data-product-name="{{ product.name|e('html_attr') }}"
            data-product-price="{{ product.price }}"
            data-stock-limit="{{ product.stock }}"
            data-csrf-token="{{ csrf_token('buy_now_' ~ product.id) }}"
            {{ product.stock <= 0 ? 'disabled' : '' }}
        >{{ product.stock > 0 ? 'Buy now' : 'Out of stock' }}</button>
    </main>
{% endblock %}
