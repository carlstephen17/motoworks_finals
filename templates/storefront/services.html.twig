{% extends 'base.html.twig' %}

{% block title %}Our Services - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/services.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/index/modals.css') }}">
{% endblock %}

{% block body %}
    <main id="main-content" class="container main-content-shop">
        <div class="section-title">
            <h2>Professional Services & Tune-Ups</h2>
        </div>

        <!-- SEARCH -->
        <div class="search-bar-container">
            <input
                type="text"
                id="product-search-input"
                class="search-input-field"
                placeholder="Search services..."
                autocomplete="off"
            >
        </div>

        <!-- SERVICE GRID -->
        <div class="card-grid product-grid" id="product-grid-container">
            {% for s in services %}
                {% set isFeatured = s.isFeatured %}
                {% set cardClass = isFeatured ? 'product-card product-card-featured' : 'product-card' %}
                {% set btnClass = isFeatured ? 'btn btn-cyan' : 'btn btn-primary' %}

                <div class="{{ cardClass }}" data-name="{{ s.name|lower }}">
                    <!-- IMAGE -->
                    <div class="product-image">
                        {% if s.image %}
                            <img src="{{ asset(s.image) }}" alt="{{ s.name }}">
                        {% else %}
                            <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true" style="font-size: 3rem; color: var(--color-text-muted, #a0a0a0);"></i>
                        {% endif %}
                    </div>

                    <!-- NAME -->
                    <h3 class="product-name">{{ s.name }}</h3>

                    <!-- DESCRIPTION -->
                    {% if s.description %}
                        <p class="product-description" style="font-size: 13px; opacity: 0.8; margin-bottom: 10px;">
                            {{ s.description }}
                        </p>
                    {% endif %}

                    <!-- PRICE -->
                    <div class="product-price">₱{{ s.price|number_format(2) }}</div>

                    <!-- ACTIONS -->
                    <div class="product-card-actions">
                        <button
                            type="button"
                            onclick='openServiceBookingModal({{ s.id }}, {{ s.name|json_encode|e('html_attr') }})'
                            class="{{ btnClass }} btn-block"
                        >
                            Book Appointment
                        </button>
                    </div>
                </div>
            {% else %}
                <p style="grid-column: 1 / -1; text-align: center; color: var(--color-text-muted, #a0a0a0);">No services are currently available.</p>
            {% endfor %}
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('product-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const query = e.target.value.toLowerCase().trim();
                    const cards = document.querySelectorAll('#product-grid-container .product-card');
                    cards.forEach(card => {
                        const name = card.getAttribute('data-name') || '';
                        card.style.display = name.includes(query) ? '' : 'none';
                    });
                });
            }
        });
    </script>
{% endblock %}
