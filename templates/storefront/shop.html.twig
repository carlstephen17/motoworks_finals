{% extends 'base.html.twig' %}

{% block title %}All Products & Genuine Parts - Bencalo MotoWorks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/services.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/shop.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/index/modals.css') }}">
{% endblock %}

{% block body %}
    <main id="main-content" class="container main-content-shop">
        <div class="section-title">
            <h2>All Products & Genuine Parts</h2>
        </div>

        <!-- SEARCH -->
        <div class="search-bar-container">
            <input
                type="text"
                id="product-search-input"
                class="search-input-field"
                placeholder="Search catalog..."
                autocomplete="off"
            >
        </div>

        <!-- PRODUCT GRID -->
        <div class="card-grid product-grid" id="product-grid-container">
            {% for productEntry in products %}
                {% set product = productEntry.product %}
                {% set stockLevel = product.stock %}
                <div class="product-card" data-name="{{ product.name|lower }}" data-product-id="{{ product.id }}">
                    <!-- IMAGE -->
                    <div class="product-image">
                        {% if productEntry.image %}
                            <img src="{{ asset(productEntry.image) }}" alt="{{ product.name }}">
                        {% else %}
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                        {% endif %}
                    </div>

                    <!-- NAME -->
                    <h3 class="product-name">{{ product.name }}</h3>

                    <!-- PRICE -->
                    <div class="product-price">₱{{ product.price|number_format(2) }}</div>

                    <!-- STOCK -->
                    <div
                        class="product-stock"
                        data-stock-display
                        style="font-size: 0.85rem; margin: 5px 0 10px 0; color: {{ stockLevel > 0 ? '#2e7d32' : '#c62828' }};"
                    >
                        {% if stockLevel > 0 %}
                            Stock: <strong>{{ stockLevel }}</strong> available
                        {% else %}
                            Out of Stock
                        {% endif %}
                    </div>

                    <!-- ACTIONS -->
                    <div class="product-card-actions">
                        <!-- ADD TO CART -->
                        <button
                            type="button"
                            class="btn btn-outline btn-block btn-cart-add js-add-to-cart"
                            data-product-id="{{ product.id }}"
                            data-product-name="{{ product.name|e('html_attr') }}"
                            data-product-price="{{ product.price }}"
                            data-stock-limit="{{ stockLevel }}"
                            data-csrf-token="{{ csrf_token('cart_add_' ~ product.id) }}"
                            aria-label="Add to cart"
                            {{ stockLevel <= 0 ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : '' }}
                        >
                            <i class="fa-solid fa-cart-plus"></i>
                        </button>

                        <!-- BUY NOW -->
                        <button
                            type="button"
                            class="btn {{ stockLevel > 0 ? 'btn-primary' : 'btn-secondary' }} btn-block js-buy-now"
                            data-product-id="{{ product.id }}"
                            data-product-name="{{ product.name|e('html_attr') }}"
                            data-product-price="{{ product.price }}"
                            data-stock-limit="{{ stockLevel }}"
                            data-csrf-token="{{ csrf_token('buy_now_' ~ product.id) }}"
                            {{ stockLevel <= 0 ? 'disabled style="background: #ccc; cursor: not-allowed; border-color: #ccc;"' : '' }}
                        >{{ stockLevel > 0 ? 'Buy Now' : 'Out of Stock' }}</button>
                    </div>
                </div>
            {% else %}
                <p style="grid-column: 1 / -1; text-align: center; color: var(--color-text-muted, #a0a0a0);">No products are currently available.</p>
            {% endfor %}
        </div>
    </main>

    <script>
        (function() {
            const searchInput = document.getElementById('product-search-input');
            if (!searchInput || searchInput.dataset.searchInitialized) return;

            searchInput.dataset.searchInitialized = 'true';
            searchInput.addEventListener('input', function(e) {
                const query = e.target.value.toLowerCase().trim();
                const cards = document.querySelectorAll('#product-grid-container .product-card');
                cards.forEach(card => {
                    const name = card.getAttribute('data-name') || '';
                    card.style.display = name.includes(query) ? '' : 'none';
                });
            });
        })();
    </script>
{% endblock %}
